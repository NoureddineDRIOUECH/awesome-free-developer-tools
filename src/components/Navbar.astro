---
import { tools, categories } from "../lib/tools";
---

<nav class="sticky top-0 z-50 border-b border-surface-container-highest bg-surface/80 backdrop-blur-xl">
  <div class="container-main flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="size-8 rounded-lg bg-primary flex items-center justify-center">
        <svg class="size-4 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <span class="text-lg font-semibold tracking-tight">WebUtil</span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      <a href="/tools" class="px-3 py-2 text-sm text-on-surface-variant hover:text-on-surface rounded-md transition-colors">
        All Tools
      </a>
      <div class="relative group">
        <button class="px-3 py-2 text-sm text-on-surface-variant hover:text-on-surface rounded-md transition-colors flex items-center gap-1">
          Categories
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute top-full left-0 mt-1 w-64 rounded-lg border border-surface-container-highest bg-surface-container p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-xl">
          {categories.map((cat) => (
            <a
              href={`/tools?category=${cat.id}`}
              class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
            >
              <span class="material-symbols-outlined text-base">{cat.icon}</span>
              <span>{cat.name}</span>
              <span class="ml-auto text-xs text-on-surface-variant/50">{tools.filter(t => t.category === cat.id).length}</span>
            </a>
          ))}
        </div>
      </div>
      <a href="/blog" class="px-3 py-2 text-sm text-on-surface-variant hover:text-on-surface rounded-md transition-colors">
        Blog
      </a>
    </div>

    <button class="md:hidden p-2 rounded-lg hover:bg-surface-container-high transition-colors" aria-label="Menu">
      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
</nav>
