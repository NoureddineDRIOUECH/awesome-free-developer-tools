---
import { tools, categories, getToolUrl } from "../lib/tools";
const nonEmptyCategories = categories.filter((c) => tools.some((t) => t.category === c.id));
const catCounts = Object.fromEntries(nonEmptyCategories.map((c) => [c.id, tools.filter((t) => t.category === c.id).length]));
const allToolItems = tools.map((t) => ({ id: t.id, title: t.title, category: t.category, url: getToolUrl(t) }));
---

<nav class="sticky top-0 z-50 border-b border-surface-container-highest bg-background/80 backdrop-blur-xl">
  <div class="container-main flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <div class="size-8 rounded-lg bg-primary flex items-center justify-center transition-all duration-200 group-hover:shadow-[0_0_16px_rgba(126,81,224,0.4)]">
        <svg class="size-4 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <span class="text-lg font-semibold tracking-tight">WebUtil</span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      <a href="/tools" class="nav-link">All Tools</a>
      <div class="relative group">
        <button class="nav-link flex items-center gap-1 cursor-default" aria-label="Categories dropdown">
          Categories
          <svg class="size-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute top-full left-0 mt-1 w-56 rounded-xl border border-surface-container-highest bg-surface-container p-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-2xl translate-y-1 group-hover:translate-y-0">
          {nonEmptyCategories.map((cat) => (
            <a
              href={`/tools/category/${cat.id}`}
              class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all duration-150"
            >
              <span>{cat.name}</span>
              <span class="ml-auto text-xs text-on-surface-variant/50 bg-surface-container-high px-1.5 py-0.5 rounded-md">{catCounts[cat.id]}</span>
            </a>
          ))}
        </div>
      </div>
      <a href="/blog" class="nav-link">Blog</a>
      <a href="/about" class="nav-link">About</a>
    </div>

    <div class="flex items-center gap-2">
      <button id="cmd-k-trigger" class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-lg border border-surface-container-highest text-xs text-on-surface-variant/60 hover:text-on-surface-variant hover:border-outline/50 transition-all duration-200 cursor-pointer" aria-label="Search tools (Cmd+K)">
        <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        Search...
        <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded border border-surface-container-highest bg-surface-container text-[10px] font-mono"><span>⌘</span>K</kbd>
      </button>

      <button id="nav-toggle" class="md:hidden p-2 rounded-lg hover:bg-surface-container-high transition-colors" aria-label="Open menu">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden fixed inset-0 z-50 hidden">
    <div id="nav-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm animate-fade-in"></div>
    <div class="absolute right-0 top-0 h-full w-80 max-w-[85vw] bg-surface-container border-l border-surface-container-highest shadow-2xl flex flex-col translate-x-0 animate-slide-in-right">
      <div class="flex items-center justify-between px-5 h-16 border-b border-surface-container-highest shrink-0">
        <span class="font-semibold text-sm">Menu</span>
        <button id="nav-close" class="p-2 rounded-lg hover:bg-surface-container-high transition-colors" aria-label="Close menu">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="px-5 pt-4 pb-3 shrink-0">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-on-surface-variant/50 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="mobile-search"
            type="search"
            placeholder="Search tools..."
            class="w-full rounded-lg border border-surface-container-highest bg-surface-container-low pl-9 pr-3 py-2.5 text-sm text-on-surface placeholder:text-on-surface-variant/40 transition-colors focus:border-primary/50 focus:outline-none"
          />
        </div>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 pb-4 space-y-0.5 scrollbar-thin">
        <a href="/tools" class="mobile-nav-link" data-close>
          <svg class="size-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
          </svg>
          <span>All Tools</span>
        </a>
        <div>
          <button id="cat-toggle-mobile" class="mobile-nav-link w-full flex items-center justify-between">
            <span class="flex items-center gap-3">
              <svg class="size-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              Categories
            </span>
            <svg id="cat-chevron" class="size-4 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="cat-sub-mobile" class="hidden mt-0.5 ml-4 pl-3 border-l border-surface-container-highest space-y-0.5">
            {nonEmptyCategories.map((cat) => (
              <a
                href={`/tools/category/${cat.id}`}
                class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-close
              >
                <span>{cat.name}</span>
                <span class="ml-auto text-xs text-on-surface-variant/50 bg-surface-container-high px-1.5 py-0.5 rounded-md">{catCounts[cat.id]}</span>
              </a>
            ))}
          </div>
        </div>
        <a href="/blog" class="mobile-nav-link" data-close>
          <svg class="size-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          <span>Blog</span>
        </a>
        <a href="/about" class="mobile-nav-link" data-close>
          <svg class="size-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>About</span>
        </a>
      </nav>

      <div class="p-4 border-t border-surface-container-highest shrink-0">
        <a href="/tools" class="flex items-center justify-center gap-2 w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-white transition-all duration-200 hover:bg-primary-hover hover:shadow-[0_0_16px_rgba(126,81,224,0.3)]" data-close>
          Browse All Tools
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<div id="cmd-k-modal" class="fixed inset-0 z-[100] hidden">
  <div id="cmd-k-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="absolute inset-4 sm:inset-x-1/4 sm:top-[15%] sm:bottom-auto max-h-[60vh] rounded-xl border border-surface-container-highest bg-surface-container shadow-2xl overflow-hidden flex flex-col animate-slide-up">
    <div class="flex items-center gap-3 px-4 h-14 border-b border-surface-container-highest shrink-0">
      <svg class="size-4 text-on-surface-variant/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input
        id="cmd-k-input"
        type="text"
        placeholder="Search tools..."
        class="flex-1 bg-transparent text-sm text-on-surface placeholder:text-on-surface-variant/40 outline-none"
        autofocus
      />
      <kbd class="text-[10px] text-on-surface-variant/40 font-mono border border-surface-container-highest rounded px-1.5 py-0.5">ESC</kbd>
    </div>
    <div id="cmd-k-results" class="flex-1 overflow-y-auto p-2 space-y-0.5 scrollbar-thin min-h-[200px]">
      <div class="p-3 text-center text-xs text-on-surface-variant/40">Start typing to search...</div>
    </div>
  </div>
</div>

<style>
  .nav-link {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    border-radius: 0.5rem;
    transition: all 0.15s;
    position: relative;
  }
  .nav-link:hover {
    color: var(--color-on-surface);
    background-color: rgba(255, 255, 255, 0.04);
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    border-radius: 0.5rem;
    transition: all 0.15s;
  }
  .mobile-nav-link:hover {
    color: var(--color-on-surface);
    background-color: var(--color-surface-container-high);
  }
  #cmd-k-results a:first-child {
    background-color: var(--color-surface-container-high);
    color: var(--color-on-surface);
  }
  @keyframes slide-in-right {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  .animate-slide-in-right {
    animation: slide-in-right 0.25s ease-out;
  }
</style>

<script>
const NAV_DATA = {
  tools: JSON.parse(document.getElementById("nav-tools-data")?.textContent || "[]"),
};

function closeMobileMenu() {
  const m = document.getElementById("mobile-menu");
  if (m) { m.classList.add("hidden"); document.body.style.overflow = ""; }
}

function openMobileMenu() {
  const m = document.getElementById("mobile-menu");
  if (m) { m.classList.remove("hidden"); document.body.style.overflow = "hidden"; }
}

document.addEventListener("astro:page-load", function () {
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("nav-overlay");
  const closeBtn = document.getElementById("nav-close");
  const catToggle = document.getElementById("cat-toggle-mobile");
  const catSub = document.getElementById("cat-sub-mobile");
  const catChevron = document.getElementById("cat-chevron");
  const mobileSearch = document.getElementById("mobile-search");

  if (toggle) toggle.removeEventListener("click", openMobileMenu);
  if (toggle) toggle.addEventListener("click", openMobileMenu);
  if (closeBtn) closeBtn.removeEventListener("click", closeMobileMenu);
  if (closeBtn) closeBtn.addEventListener("click", closeMobileMenu);
  if (overlay) overlay.removeEventListener("click", closeMobileMenu);
  document.querySelectorAll("[data-close]").forEach(function (el) {
    el.removeEventListener("click", closeMobileMenu);
    el.addEventListener("click", closeMobileMenu);
  });

  if (catToggle && catSub && catChevron) {
    catToggle.removeEventListener("click", toggleCat);
    catToggle.addEventListener("click", toggleCat);
  }

  if (mobileSearch) {
    mobileSearch.removeEventListener("input", searchMobile);
    mobileSearch.addEventListener("input", searchMobile);
  }

  document.removeEventListener("keydown", escHandler);
  document.addEventListener("keydown", escHandler);
});

function escHandler(e) {
  if (e.key === "Escape") {
    closeMobileMenu();
    closeCmdK();
  }
  if ((e.metaKey || e.ctrlKey) && e.key === "k") {
    e.preventDefault();
    toggleCmdK();
  }
}

function toggleCat() {
  const sub = document.getElementById("cat-sub-mobile");
  const ch = document.getElementById("cat-chevron");
  if (sub && ch) {
    sub.classList.toggle("hidden");
    ch.classList.toggle("rotate-180");
  }
}

function searchMobile() {
  var q = this.value.toLowerCase().trim();
  var links = this.closest("#mobile-menu").querySelectorAll(".mobile-nav-link, [data-close]");
  links.forEach(function (l) {
    if (l.tagName !== "A") return;
    var txt = l.textContent.toLowerCase();
    l.style.display = !q || txt.includes(q) ? "flex" : "none";
  });
}

function openCmdK() {
  var modal = document.getElementById("cmd-k-modal");
  var input = document.getElementById("cmd-k-input");
  var results = document.getElementById("cmd-k-results");
  if (!modal || !input) return;
  results.innerHTML = '<div class="p-3 text-center text-xs text-on-surface-variant/40">Start typing to search...</div>';
  modal.classList.remove("hidden");
  document.body.style.overflow = "hidden";
  setTimeout(function () { input.focus(); }, 50);
}

function closeCmdK() {
  var modal = document.getElementById("cmd-k-modal");
  if (modal) modal.classList.add("hidden");
  document.body.style.overflow = "";
}

function toggleCmdK() {
  var modal = document.getElementById("cmd-k-modal");
  if (modal.classList.contains("hidden")) openCmdK();
  else closeCmdK();
}

function setupCmdK() {
  var trigger = document.getElementById("cmd-k-trigger");
  var modal = document.getElementById("cmd-k-modal");
  var overlay = document.getElementById("cmd-k-overlay");
  var input = document.getElementById("cmd-k-input");
  var results = document.getElementById("cmd-k-results");
  if (!modal || !input || !results) return;

  trigger.removeEventListener("click", openCmdK);
  trigger.addEventListener("click", openCmdK);
  overlay.removeEventListener("click", closeCmdK);
  overlay.addEventListener("click", closeCmdK);

  input.removeEventListener("input", searchCmdK);
  input.addEventListener("input", searchCmdK);

  input.removeEventListener("keydown", navCmdK);
  input.addEventListener("keydown", navCmdK);
}

function searchCmdK() {
  var q = this.value.toLowerCase().trim();
  var results = document.getElementById("cmd-k-results");
  var tools = NAV_DATA.tools;
  if (!q) {
    results.innerHTML = '<div class="p-3 text-center text-xs text-on-surface-variant/40">Start typing to search...</div>';
    return;
  }
  var matched = tools.filter(function (t) {
    return t.title.toLowerCase().includes(q) || t.id.includes(q) || t.category.includes(q);
  }).slice(0, 10);

  if (!matched.length) {
    results.innerHTML = '<div class="p-3 text-center text-xs text-on-surface-variant/40">No tools found</div>';
    return;
  }
  results.innerHTML = matched.map(function (t, i) {
    return '<a href="' + t.url + '" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors" data-index="' + i + '" data-close-cmdk>' +
      '<svg class="size-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>' +
      '<span>' + t.title + '</span>' +
      '<span class="ml-auto text-xs text-on-surface-variant/30">' + t.category + '</span>' +
      '</a>';
  }).join("");

  results.querySelectorAll("[data-close-cmdk]").forEach(function (el) {
    el.addEventListener("click", closeCmdK);
  });
}

function navCmdK(e) {
  var results = document.getElementById("cmd-k-results");
  var items = results.querySelectorAll("a");
  if (!items.length) return;
  var idx = Array.from(items).findIndex(function (i) { return i.matches(":hover") || i.dataset.selected === "true"; });
  if (e.key === "ArrowDown") {
    e.preventDefault();
    var next = Math.min(idx + 1, items.length - 1);
    items.forEach(function (i) { i.dataset.selected = "false"; i.style.background = ""; });
    items[next].dataset.selected = "true";
    items[next].style.background = "var(--color-surface-container-high)";
    items[next].scrollIntoView({ block: "nearest" });
  } else if (e.key === "ArrowUp") {
    e.preventDefault();
    var prev = Math.max(idx - 1, 0);
    items.forEach(function (i) { i.dataset.selected = "false"; i.style.background = ""; });
    items[prev].dataset.selected = "true";
    items[prev].style.background = "var(--color-surface-container-high)";
    items[prev].scrollIntoView({ block: "nearest" });
  } else if (e.key === "Enter") {
    e.preventDefault();
    var selected = items[idx >= 0 ? idx : 0];
    if (selected) { closeCmdK(); window.location.href = selected.href; }
  }
}

document.addEventListener("astro:page-load", setupCmdK);
</script>

<script type="application/json" id="nav-tools-data">{JSON.stringify(allToolItems)}</script>
