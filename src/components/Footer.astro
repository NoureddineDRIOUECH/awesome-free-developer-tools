---
import { categories } from "../lib/tools";
---

<footer class="border-t border-surface-container-highest mt-20">
  <div class="container-main py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <div class="size-7 rounded-md bg-primary flex items-center justify-center">
            <svg class="size-3.5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="text-base font-semibold">WebUtil</span>
        </a>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Free online utility tools for developers. All tools run entirely in your browser — nothing is uploaded to any server.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-on-surface tracking-wider uppercase mb-4">Tools</h3>
        <ul class="space-y-2.5">
          {categories.slice(0, 4).map((cat) => (
            <li>
              <a href={`/tools?category=${cat.id}`} class="text-sm text-on-surface-variant hover:text-on-surface transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-on-surface tracking-wider uppercase mb-4">More Tools</h3>
        <ul class="space-y-2.5">
          {categories.slice(4).map((cat) => (
            <li>
              <a href={`/tools?category=${cat.id}`} class="text-sm text-on-surface-variant hover:text-on-surface transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-on-surface tracking-wider uppercase mb-4">Links</h3>
        <ul class="space-y-2.5">
          <li><a href="/blog" class="text-sm text-on-surface-variant hover:text-on-surface transition-colors">Blog</a></li>
          <li><a href="/faq" class="text-sm text-on-surface-variant hover:text-on-surface transition-colors">FAQ</a></li>
          <li><a href="/contact" class="text-sm text-on-surface-variant hover:text-on-surface transition-colors">Contact</a></li>
          <li><a href="/privacy" class="text-sm text-on-surface-variant hover:text-on-surface transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-on-surface-variant hover:text-on-surface transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-surface-container-highest flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-on-surface-variant/70">
        &copy; {new Date().getFullYear()} WebUtil. All rights reserved. All tools run client-side in your browser.
      </p>
      <p class="text-xs text-on-surface-variant/60">
        Built for speed, privacy, and SEO.
      </p>
    </div>
  </div>
</footer>
