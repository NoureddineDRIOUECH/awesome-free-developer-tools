---
const popular = [
  { title: "JSON Formatter", href: "/dev/json-formatter", desc: "Format, validate, and beautify JSON data" },
  { title: "Base64 Encoder", href: "/dev/base64-encoder", desc: "Encode and decode Base64 instantly" },
  { title: "JWT Decoder", href: "/dev/jwt-decoder", desc: "Decode and inspect JWT tokens" },
  { title: "Regex Tester", href: "/text/regex-tester", desc: "Test regular expressions in real-time" },
  { title: "Hash Generator", href: "/dev/hash-generator", desc: "Generate MD5, SHA-1, SHA-256 hashes" },
];
---

<div class="border border-surface-container-highest bg-surface-container-low rounded-lg p-4 sm:p-5">
  <h3 class="text-sm font-semibold mb-3 tracking-tight">Popular Developer Tools</h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1">
    {popular.map((tool) => (
      <a
        href={tool.href}
        class="flex items-center gap-2.5 p-2 rounded-md hover:bg-surface-container-high transition-colors"
      >
        <svg class="size-3.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        <div>
          <span class="text-sm font-medium">{tool.title}</span>
          <p class="text-xs text-on-surface-variant leading-tight">{tool.desc}</p>
        </div>
      </a>
    ))}
  </div>
</div>
