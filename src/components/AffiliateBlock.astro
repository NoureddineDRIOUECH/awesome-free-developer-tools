---
export interface Props {
  category: string;
}

const { category } = Astro.props;

interface AffiliateContent {
  icon: string;
  title: string;
  description: string;
  links: { label: string; url: string }[];
}

const contentMap: Record<string, AffiliateContent> = {
  dev: {
    icon: `<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15l4-8l4 8m-6 0h4m10-4l4 4l-4 4m-4-8l-4 4l4 4"/></svg>`,
    title: "Deploy Your Next Project Fast",
    description: "Get $200 free credit on DigitalOcean to deploy your apps with blazing-fast infrastructure.",
    links: [{ label: "Try DigitalOcean", url: "#" }],
  },
  generate: {
    icon: `<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    title: "Keep Your Credentials Safe",
    description: "Save generated passwords and secrets in a secure vault. Try a trusted password manager.",
    links: [
      { label: "1Password", url: "#" },
      { label: "Bitwarden", url: "#" },
    ],
  },
  text: {
    icon: `<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
    title: "Need a Fast Code Editor?",
    description: "Write, edit, and refactor code with a modern editor built for speed and productivity.",
    links: [
      { label: "VS Code", url: "#" },
      { label: "Cursor", url: "#" },
    ],
  },
};

const content = contentMap[category] || contentMap.dev;
---

<div class="container-main py-6" data-geo-category={category}>
  <div class="max-w-4xl mx-auto">
    <div class="rounded-lg border border-surface-container-highest bg-surface-container-low p-4 sm:p-5" data-sponsored>
      <div class="flex items-start gap-4">
        <div class="shrink-0 size-10 rounded-md bg-surface-container-high text-primary flex items-center justify-center" set:html={content.icon}>
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="text-sm font-semibold">{content.title}</h3>
          <p class="mt-1 text-xs text-on-surface-variant">{content.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {content.links.map((link) => (
              <a
                href={link.url}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-surface-container-highest text-xs font-medium text-on-surface-variant hover:text-on-surface hover:border-outline/50 transition-colors"
                rel="sponsored noopener"
                target="_blank"
              >
                {link.label}
                <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
