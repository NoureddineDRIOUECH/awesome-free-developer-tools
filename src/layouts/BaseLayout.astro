---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import type { BreadcrumbItem } from "../components/Breadcrumb.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  jsonLd,
  breadcrumbs,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <Analytics />
  </head>
  <body class="min-h-screen bg-background text-on-surface antialiased">
    <Navbar />
    <main>
      {breadcrumbs && <div class="container-main pt-6"><Breadcrumb items={breadcrumbs} /></div>}
      <slot />
    </main>
    <Footer />
  </body>
</html>
