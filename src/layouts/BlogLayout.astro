---
import BaseLayout from "./BaseLayout.astro";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  publishDate?: Date;
  author?: string;
  category?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  jsonLd,
  publishDate,
  author = "WebUtil Team",
  category,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="container-main py-12 max-w-3xl mx-auto" slot="default">
    <header class="mb-10">
      <div class="flex items-center gap-3 text-sm text-on-surface-variant mb-4">
        {category && (
          <>
            <span class="chip active text-xs cursor-default">{category}</span>
            <span aria-hidden="true">&middot;</span>
          </>
        )}
        {publishDate && (
          <time datetime={publishDate.toISOString()}>
            {publishDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight">{title}</h1>
      <p class="mt-3 text-lg text-on-surface-variant">{description}</p>
      <div class="mt-4 flex items-center gap-3 text-sm text-on-surface-variant">
        <span>{author}</span>
      </div>
    </header>

    <div class="prose prose-invert max-w-none
      prose-headings:font-semibold prose-headings:tracking-tight
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-code:text-primary prose-code:bg-surface-container-high prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
      prose-pre:bg-surface-container prose-pre:border prose-pre:border-surface-container-highest
      prose-strong:text-on-surface
      prose-blockquote:border-primary prose-blockquote:text-on-surface-variant
      prose-li:marker:text-outline
    ">
      <slot />
    </div>

    <footer class="mt-12 pt-8 border-t border-surface-container-highest">
      <p class="text-sm text-on-surface-variant">
        <a href="/blog" class="text-primary hover:underline">&larr; Back to Blog</a>
      </p>
    </footer>
  </article>
</BaseLayout>
