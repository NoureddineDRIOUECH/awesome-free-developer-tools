---
import BaseLayout from "./BaseLayout.astro";
import PopularTools from "../components/PopularTools.astro";
import AffiliateBlock from "../components/AffiliateBlock.astro";
import { tools, getRelatedTools, getCategoryInfo, getToolUrl, type ToolDefinition } from "../lib/tools";
import { getToolDataById } from "../data/tools";

export interface Props {
  tool: ToolDefinition;
  codeSnippets?: { lang: "javascript" | "python" | "go" | "bash"; label: string; code: string }[];
  faqItems?: { question: string; answer: string }[];
  children?: any;
}

const { tool, codeSnippets: inlineCodeSnippets, faqItems: inlineFaqItems } = Astro.props;
const toolData = getToolDataById(tool.id);
const codeSnippets = inlineCodeSnippets ?? toolData?.codeSnippets ?? [];
const faqItems = inlineFaqItems ?? toolData?.faqItems ?? [];
const siteUrl = String(Astro.site).replace(/\/$/, "");
const pageUrl = `${siteUrl}${getToolUrl(tool)}`;
const category = getCategoryInfo(tool.category);

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.title,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  description: tool.metaDescription,
  url: pageUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: "WebUtil" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}/tools` },
    ...(category ? [{ "@type": "ListItem", position: 3, name: category.name, item: `${siteUrl}/tools/category/${category.id}` }] : []),
    { "@type": "ListItem", position: category ? 4 : 3, name: tool.title, item: pageUrl },
  ],
};

const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
} : null;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `How to Use the ${tool.title}`,
  description: `Learn how to use the free online ${tool.title.toLowerCase()} tool. All processing happens in your browser.`,
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Enter your input",
      text: "Paste or type your data into the input area on the page.",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Configure options",
      text: "Select any available options or settings to customize the output.",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Get results instantly",
      text: "Your results appear instantly. All processing runs 100% client-side in your browser.",
    },
  ],
};

const schemas = [softwareSchema, breadcrumbSchema, howToSchema, ...(faqSchema ? [faqSchema] : [])];

const allTabs = codeSnippets.length > 0
  ? codeSnippets
  : [];

const related = getRelatedTools(tool.id);
---

<BaseLayout
  title={`${tool.title} Online - Free ${category?.name || "Developer"} Tool`}
  description={tool.metaDescription}
  canonical={pageUrl}
  jsonLd={schemas}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Tools", href: "/tools" },
    ...(category ? [{ label: category.name, href: `/tools/category/${category.id}` }] : []),
    { label: tool.title },
  ]}
>
  <!-- Hero -->
  <section>
    <div class="container-main py-12 sm:py-16">
      <div class="max-w-3xl mx-auto text-center">
        <div class="mb-6 animate-fade-in">
          <span class="inline-flex items-center gap-1.5 rounded-md border border-surface-container-highest bg-surface-container-low px-3 py-1 text-xs font-medium text-on-surface-variant">
            Free Developer Tool — 100% Client-Side
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1]">{tool.title}</h1>
        <p class="mt-4 text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          {tool.description}
        </p>
      </div>
    </div>
  </section>

  <slot />

  {toolData?.content && (
    <section class="container-main py-8">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-sm max-w-none text-on-surface-variant leading-relaxed">
          {toolData.content.split("\n\n").map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  {allTabs.length > 0 && (
    <section class="container-main py-12">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-semibold tracking-tight mb-6">How to Do This in Code</h2>
        <div class="rounded-lg border border-surface-container-highest bg-surface-container-low overflow-hidden">
          <div class="flex border-b border-surface-container-highest overflow-x-auto" role="tablist">
            {allTabs.map((tab) => (
              <button
                class="code-tab px-4 py-2.5 text-xs font-medium text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap border-b-2 border-transparent"
                data-lang={tab.lang}
                role="tab"
              >{tab.label}</button>
            ))}
          </div>
          {allTabs.map((tab) => (
            <pre class="code-block hidden" data-lang={tab.lang}><code class="text-sm font-mono leading-relaxed">{tab.code}</code></pre>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="container-main py-8">
    <div class="max-w-4xl mx-auto">
      <PopularTools />
    </div>
  </section>

  <AffiliateBlock category={tool.category} />

  {related.length > 0 && (
    <section class="container-main py-8 pb-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-semibold tracking-tight mb-6">Related Tools</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {related.map((rt) => (
            <a href={getToolUrl(rt)} class="border border-surface-container-highest bg-surface-container-low rounded-lg block p-4 transition-all duration-150 hover:border-primary/30">
              <h3 class="font-semibold text-sm">{rt.title}</h3>
              <p class="mt-1 text-xs text-on-surface-variant leading-relaxed">{rt.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {faqItems.length > 0 && (
    <section class="container-main py-8 pb-16">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-semibold tracking-tight mb-6">{tool.title} FAQ</h2>
        <div class="space-y-2">
          {faqItems.map((item) => (
            <details class="border border-surface-container-highest bg-surface-container-low rounded-lg p-4 group open:border-primary/30 transition-all duration-150 cursor-pointer">
              <summary class="text-sm font-medium list-none flex items-center justify-between gap-4">
                <span>{item.question}</span>
                <svg class="size-4 text-outline shrink-0 open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="mt-2 text-xs text-on-surface-variant leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script is:inline>
document.addEventListener("astro:page-load", function () {
  var tabs = document.querySelectorAll(".code-tab");
  var blocks = document.querySelectorAll(".code-block");

  function activateTab(lang) {
    tabs.forEach(function (t) {
      var active = t.dataset.lang === lang;
      t.classList.toggle("border-primary", active);
      t.classList.toggle("text-primary", active);
      t.classList.toggle("text-on-surface-variant", !active);
      t.classList.toggle("border-transparent", !active);
    });
    blocks.forEach(function (b) {
      b.classList.toggle("hidden", b.dataset.lang !== lang);
    });
  }

  tabs.forEach(function (tab) {
    tab.addEventListener("click", function () {
      activateTab(this.dataset.lang);
    });
  });

  if (tabs.length > 0) activateTab(tabs[0].dataset.lang);
});
</script>

<style>
  .code-block {
    padding: 1rem;
    overflow-x: auto;
    -webkit-font-smoothing: antialiased;
  }
  .code-block code {
    color: var(--color-on-surface-variant);
  }
</style>
