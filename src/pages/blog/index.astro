const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "WebUtil Developer Blog",
  description: "Developer guides and tutorials on JSON formatting, Base64 encoding, password security, color conversion, and more.",
  url: `${String(Astro.site).replace(/\/$/, "")}/blog`,
};
---

<BaseLayout
  title="Developer Blog - Web Development Guides & Tutorials"
  description="Expert guides on JSON formatting, Base64 encoding, URL encoding, password security, color conversion, and more. Learn best practices for online developer tools."
  jsonLd={blogSchema}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog" },
  ]}
>
  <div class="container-main py-10">
    <div class="max-w-4xl mx-auto">
      <div class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Developer Blog</h1>
        <p class="mt-2 text-on-surface-variant text-lg">
          Guides, tutorials, and best practices for developers. Learn how to use our tools effectively.
        </p>
      </div>

      <div class="grid gap-6">
        {blogPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="tool-card group block"
          >
            <div class="flex items-center gap-3 text-xs text-on-surface-variant mb-3">
              <span class="chip active text-xs cursor-default">{post.category}</span>
              <span>{post.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
              <span>&middot;</span>
              <span>{post.readTime}</span>
            </div>
            <h2 class="text-lg font-semibold group-hover:text-primary transition-colors">{post.title}</h2>
            <p class="mt-1.5 text-sm text-on-surface-variant leading-relaxed">{post.description}</p>
            <div class="mt-3 text-sm text-primary flex items-center gap-1">
              Read more <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <AdSlot format="in-article" class="mt-8" />
    </div>
  </div>
</BaseLayout>
