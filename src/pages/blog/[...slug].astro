---
import BlogLayout from "../../layouts/BlogLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { getBlogPosts, getBlogPost, getToolLink } from "../../data/blog";
import { getToolById, getToolUrl } from "../../lib/tools";

export async function getStaticPaths() {
  return getBlogPosts().map((p) => ({
    params: { slug: p.slug },
    props: { slug: p.slug, category: p.category },
  }));
}

const { slug, category } = Astro.props;
const canonical = `${String(Astro.site).replace(/\/$/, "")}/blog/${slug}`;

const post = getBlogPost(slug);

if (!post) {
  return Astro.redirect("/blog", 301);
}

const toolId = getToolLink(slug);
const tool = toolId ? getToolById(toolId) : undefined;
const toolUrl = tool ? getToolUrl(tool) : null;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.description,
  author: { "@type": "Organization", name: "WebUtil" },
  datePublished: post.date.toISOString(),
  dateModified: post.date.toISOString(),
  publisher: { "@type": "Organization", name: "WebUtil" },
};
const allPosts = getBlogPosts();
const morePosts = allPosts.filter((p) => p.slug !== slug).slice(0, 3);
---

<BlogLayout
  title={post.title}
  description={post.description}
  canonical={canonical}
  jsonLd={articleSchema}
  publishDate={post.date}
  category={category}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog" },
    { label: post.title },
  ]}
>
  {post.sections.map((section, i) => (
    <section class="mb-8">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-on-surface mb-3">{section.heading}</h2>
      {section.body.split('\n\n').map((block) => {
        const text = block.trim();
        if (!text) return null;
        if (text.startsWith('```') && text.endsWith('```')) {
          const lines = text.split('\n');
          const code = lines.slice(1, -1).join('\n');
          return (
            <pre class="bg-surface-container border border-surface-container-highest rounded-lg p-4 text-xs sm:text-sm font-mono overflow-x-auto my-4 text-on-surface leading-relaxed">
              <code>{code}</code>
            </pre>
          );
        }
        if (text.startsWith('- ') || text.startsWith('* ')) {
          const items = text.split('\n').filter((l) => l.trim().startsWith('- ') || l.trim().startsWith('* '));
          return (
            <ul class="my-3 space-y-1.5 list-disc pl-5 text-on-surface-variant text-sm sm:text-base leading-relaxed">
              {items.map((item) => <li>{item.replace(/^[-*]\s+/, '')}</li>)}
            </ul>
          );
        }
        return <p class="text-on-surface-variant leading-relaxed text-sm sm:text-base my-3">{text}</p>;
      })}
      {i === 2 && <AdSlot format="in-article" class="my-8" />}
    </section>
  ))}

  {tool && toolUrl && (
    <div class="mt-10 pt-6 border-t border-surface-container-highest">
      <aside class="rounded-xl border border-primary/25 bg-primary/[0.04] p-5 sm:p-6 transition-all hover:border-primary/40">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-primary mb-1">
              Try It In Your Browser
            </span>
            <h3 class="text-base sm:text-lg font-semibold text-on-surface">{tool.title}</h3>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-1 max-w-xl leading-relaxed">
              {tool.description}
            </p>
          </div>
          <a
            href={toolUrl}
            class="btn-primary text-xs sm:text-sm whitespace-nowrap shrink-0 px-4 py-2.5 flex items-center gap-1.5"
          >
            <span>Open {tool.title}</span>
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </aside>
    </div>
  )}

  {morePosts.length > 0 && (
    <div class="mt-12 pt-8 border-t border-surface-container-highest">
      <h3 class="text-lg font-semibold tracking-tight text-on-surface mb-4">Recommended Articles & Guides</h3>
      <div class="grid sm:grid-cols-3 gap-4">
        {morePosts.map((p) => (
          <a
            href={`/blog/${p.slug}`}
            class="border border-surface-container-highest bg-surface-container-low rounded-lg p-4 block hover:border-primary/40 transition-all duration-150 group"
          >
            <div class="flex items-center gap-2 text-xs text-on-surface-variant mb-1.5">
              <span class="chip active text-[10px] px-1.5 py-0.5">{p.category}</span>
              <span>{p.readTime}</span>
            </div>
            <h4 class="font-semibold text-sm group-hover:text-primary transition-colors leading-snug line-clamp-2">{p.title}</h4>
            <p class="mt-1 text-xs text-on-surface-variant line-clamp-2 leading-relaxed">{p.description}</p>
          </a>
        ))}
      </div>
    </div>
  )}
</BlogLayout>
