---
import BlogLayout from "../../layouts/BlogLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { getBlogPosts, getBlogPost, getToolLink } from "../../data/blog";

export async function getStaticPaths() {
  return getBlogPosts().map((p) => ({
    params: { slug: p.slug },
    props: { slug: p.slug, category: p.category },
  }));
}

const { slug, category } = Astro.props;
const canonical = `${String(Astro.site).replace(/\/$/, "")}/blog/${slug}`;

const post = getBlogPost(slug);

if (!post) {
  return Astro.redirect("/blog", 301);
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.description,
  author: { "@type": "Organization", name: "WebUtil" },
  datePublished: post.date.toISOString(),
  dateModified: post.date.toISOString(),
  publisher: { "@type": "Organization", name: "WebUtil" },
};
---

<BlogLayout
  title={post.title}
  description={post.description}
  canonical={canonical}
  jsonLd={articleSchema}
  publishDate={post.date}
  category={category}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog" },
    { label: post.title },
  ]}
>
  {post.sections.map((section, i) => (
    <section>
      <h2>{section.heading}</h2>
      <p>{section.body}</p>
      {i === 2 && <AdSlot format="in-article" class="my-8" />}
    </section>
  ))}

  <div class="mt-8 pt-6 border-t border-surface-container-highest">
    <p class="text-sm text-on-surface-variant">
        Use our <a href={`/tools/${getToolLink(slug)}`} class="text-primary hover:underline">free online tool</a> to get started instantly.
      </p>
  </div>
</BlogLayout>
