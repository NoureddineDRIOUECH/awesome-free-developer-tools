---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Us"
  description="Contact WebUtil. Get in touch with questions, feedback, or support requests about our free online developer tools."
>
  <div class="container-main py-10 max-w-2xl mx-auto">
    <div class="text-center mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">Contact Us</h1>
      <p class="mt-2 text-on-surface-variant">Have a question, suggestion, or feedback? We'd love to hear from you.</p>
    </div>

    <div class="rounded-xl border border-surface-container-highest bg-surface-container-low p-6 sm:p-8">
      <form netlify class="space-y-5">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="text-sm font-medium mb-1.5 block">Name</label>
            <input type="text" id="name" name="name" class="input-field" required />
          </div>
          <div>
            <label for="email" class="text-sm font-medium mb-1.5 block">Email</label>
            <input type="email" id="email" name="email" class="input-field" required />
          </div>
        </div>
        <div>
          <label for="subject" class="text-sm font-medium mb-1.5 block">Subject</label>
          <select id="subject" name="subject" class="input-field">
            <option value="general">General Inquiry</option>
            <option value="feedback">Feedback</option>
            <option value="bug">Bug Report</option>
            <option value="feature">Feature Request</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label for="message" class="text-sm font-medium mb-1.5 block">Message</label>
          <textarea id="message" name="message" rows="5" class="input-field resize-y" required></textarea>
        </div>
        <button type="submit" class="btn-primary w-full sm:w-auto">
          Send Message
        </button>
      </form>
    </div>

    <div class="mt-10 grid sm:grid-cols-3 gap-6 text-center text-sm text-on-surface-variant">
      <div>
        <div class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center mx-auto mb-3">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <p class="font-medium text-on-surface">Email</p>
        <p>support@webutil.io</p>
      </div>
      <div>
        <div class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center mx-auto mb-3">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="font-medium text-on-surface">Response Time</p>
        <p>Within 24 hours</p>
      </div>
      <div>
        <div class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center mx-auto mb-3">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="font-medium text-on-surface">FAQ</p>
        <a href="/faq" class="text-primary hover:underline">Check our FAQ</a>
      </div>
    </div>
  </div>
</BaseLayout>
