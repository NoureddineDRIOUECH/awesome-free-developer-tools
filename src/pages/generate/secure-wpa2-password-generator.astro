---
import ToolLayout from "../../layouts/ToolLayout.astro";
import Toast from "../../components/Toast.astro";
import AdSlot from "../../components/AdSlot.astro";
import { getToolById } from "../../lib/tools";

const tool = getToolById("secure-wpa2-password-generator")!;
---

<ToolLayout tool={tool}>
  <section class="container-main pb-8">
    <div class="max-w-3xl mx-auto">
      <div class="tool-card p-4 sm:p-6">
        <div class="grid gap-6">
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="wp-length" class="text-sm font-medium">Password Length</label>
              <span id="wp-length-val" class="text-sm font-medium text-primary tabular-nums">16</span>
            </div>
            <input
              type="range"
              id="wp-length"
              min="12"
              max="20"
              value="16"
              class="w-full accent-primary"
            />
            <div class="flex justify-between text-xs text-on-surface-variant/60 mt-1">
              <span>12</span>
              <span>20</span>
            </div>
          </div>

          <fieldset>
            <legend class="text-sm font-medium mb-2">Include</legend>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="wp-upper" checked class="size-4 accent-primary" />
                <span class="text-sm">A–Z</span>
              </label>
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="wp-lower" checked class="size-4 accent-primary" />
                <span class="text-sm">a–z</span>
              </label>
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="wp-nums" checked class="size-4 accent-primary" />
                <span class="text-sm">2–9</span>
              </label>
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="wp-syms" class="size-4 accent-primary" />
                <span class="text-sm">!@#$%^&amp;*</span>
              </label>
            </div>
          </fieldset>

          <div class="text-xs text-on-surface-variant/60 bg-surface-container p-3 rounded-lg">
            Excluded: <code class="text-primary">l</code> (lowercase L), <code class="text-primary">1</code> (one),
            <code class="text-primary">O</code> (uppercase O), <code class="text-primary">0</code> (zero) —
            these look similar and cause typing errors on routers and smart TVs.
          </div>

          <div class="flex items-center gap-2">
            <button id="wp-generate" class="btn-primary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Generate Password
            </button>
            <button id="wp-copy" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copy
            </button>
          </div>

          <div>
            <label class="text-sm font-medium mb-1.5 block">Generated Password</label>
            <pre
              id="wp-output"
              class="input-field font-mono text-sm min-h-[56px] whitespace-pre-wrap overflow-auto scrollbar-thin break-all select-all"
            ></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">What Is a WPA2 Password?</h2>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        A <strong>WPA2 password</strong> (also called a Wi-Fi passphrase or pre-shared key) is the
        security credential that protects your wireless network. Unlike regular passwords, WPA2
        passwords must balance <strong>crack resistance</strong> with <strong>human usability</strong> —
        because you'll likely need to type them on devices without copy-paste: smart TVs, game consoles,
        printers, and IoT gadgets. Our <strong>secure Wi-Fi password generator</strong> creates
        passwords optimized for both security and manual entry.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Why Avoid Ambiguous Characters?</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        The characters <strong>l</strong> (lowercase L), <strong>1</strong> (one),
        <strong>O</strong> (uppercase O), and <strong>0</strong> (zero) are frequently confused,
        especially on router labels, printed instructions, and device screens. By removing them, this
        generator ensures that anyone entering the password on a smart TV, game console, or printer
        will not hit frustrating "wrong password" errors due to character confusion. The password
        remains mathematically strong while being practically usable.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">WPA2 vs WPA3 vs WEP</h3>
      <div class="grid sm:grid-cols-3 gap-3 mb-6">
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">WEP (Deprecated)</h4>
          <ul class="mt-1 text-xs text-on-surface-variant space-y-1 list-disc pl-4">
            <li>Easily cracked in minutes</li>
            <li>Maximum 13 characters</li>
            <li>Never use if avoidable</li>
          </ul>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">WPA2 (Recommended)</h4>
          <ul class="mt-1 text-xs text-on-surface-variant space-y-1 list-disc pl-4">
            <li>Strong AES encryption</li>
            <li>Up to 63 characters</li>
            <li>Supported by all devices</li>
          </ul>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">WPA3 (Latest)</h4>
          <ul class="mt-1 text-xs text-on-surface-variant space-y-1 list-disc pl-4">
            <li>Strongest SAE handshake</li>
            <li>Backward compatible</li>
            <li>Requires newer hardware</li>
          </ul>
        </div>
      </div>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">How to Set Up a Strong Wi-Fi Password</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        Use this generator to create a <strong>secure WPA2 password</strong> between 16 and 20 characters.
        Copy the generated password and paste it into your router's admin panel under
        <strong>Wireless Security</strong> or <strong>Wi-Fi Settings</strong>. For maximum convenience,
        also use the <a href="/generate/wi-fi-qr-code-generator" class="text-primary hover:underline">Wi-Fi QR Code Generator</a>
        to create a scannable code that guests can use to join your network instantly.
      </p>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />
</ToolLayout>

<Toast />

<script>
  const lengthInput = document.getElementById("wp-length");
  const lengthVal = document.getElementById("wp-length-val");
  const upperChk = document.getElementById("wp-upper");
  const lowerChk = document.getElementById("wp-lower");
  const numsChk = document.getElementById("wp-nums");
  const symsChk = document.getElementById("wp-syms");
  const genBtn = document.getElementById("wp-generate");
  const output = document.getElementById("wp-output");
  const copyBtn = document.getElementById("wp-copy");

  // No ambiguous l, 1, O, 0
  const UPPER = "ABCDEFGHJKMNPQRSTUVWXYZ";
  const LOWER = "abcdefghjkmnpqrstuvwxyz";
  const NUMS = "23456789";
  const SYMS = "!@#$%^&*";

  lengthInput.addEventListener("input", () => {
    lengthVal.textContent = lengthInput.value;
  });

  function getCharset() {
    let chars = "";
    if (upperChk.checked) chars += UPPER;
    if (lowerChk.checked) chars += LOWER;
    if (numsChk.checked) chars += NUMS;
    if (symsChk.checked) chars += SYMS;
    return chars;
  }

  function generatePassword(length, charset) {
    if (!charset) return "";
    const array = new Uint32Array(length);
    crypto.getRandomValues(array);
    let password = "";
    for (let i = 0; i < length; i++) {
      password += charset[array[i] % charset.length];
    }
    return password;
  }

  genBtn.onclick = () => {
    const length = parseInt(lengthInput.value, 10);
    const charset = getCharset();
    if (!charset) {
      output.textContent = "Select at least one character type.";
      return;
    }
    const password = generatePassword(length, charset);
    output.textContent = password;
  };

  copyBtn.onclick = async () => {
    const text = output.textContent;
    if (!text || text === "Select at least one character type.") return;
    try {
      gtag('event', 'copy', { tool_id: 'secure-wpa2-password-generator', content_type: 'secure-wpa2-password-generator' });
      await navigator.clipboard.writeText(text);
      if (window.showToast) showToast("Copied!");
      copyBtn.innerHTML =
        '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        copyBtn.innerHTML =
          '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
      if (window.showToast) showToast("Copied!");
      copyBtn.innerHTML =
        '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        copyBtn.innerHTML =
          '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    }
  };
</script>
