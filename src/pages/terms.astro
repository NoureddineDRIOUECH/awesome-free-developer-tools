---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteUrl = String(Astro.site).replace(/\/$/, "");

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Terms of Service - WebUtil",
  description: "WebUtil terms of service. Free online developer tools. All tools provided as-is, use at your own risk. No warranties or guarantees.",
  url: siteUrl + "/terms",
  about: {
    "@type": "Organization",
    name: "WebUtil",
  },
};
---

<BaseLayout
  title="Terms of Service"
  description="WebUtil terms of service. Free online developer tools. All tools provided as-is, use at your own risk. No warranties or guarantees."
  jsonLd={termsSchema}
>
  <div class="container-main py-10 max-w-3xl mx-auto">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Terms of Service</h1>
    <p class="text-sm text-on-surface-variant mb-8">Last updated: December 2025</p>

    <div class="space-y-6 text-sm text-on-surface-variant leading-relaxed">
      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Acceptance of Terms</h2>
        <p>By accessing or using WebUtil, you agree to be bound by these Terms of Service. If you do not agree with any part of these terms, you may not use our services.</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Service Description</h2>
        <p>WebUtil provides free online developer tools that run entirely in your browser. We do not store, process, or transmit any data entered into our tools on our servers.</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Use License</h2>
        <p>All tools on WebUtil are provided free of charge for personal and commercial use. You may not modify, reverse engineer, or redistribute our tools without explicit permission.</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Limitations</h2>
        <p>Our tools are provided "as is" without any warranty. We are not liable for any damages arising from the use of our tools. Users are responsible for verifying the accuracy of tool outputs.</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Acceptable Use</h2>
        <p>You agree not to use WebUtil for any unlawful purpose or in violation of any applicable laws. You may not attempt to disrupt our services or access restricted areas of our platform.</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Intellectual Property</h2>
        <p>The WebUtil name, logo, and design are our intellectual property. The software code for our tools is proprietary but the output generated by users belongs to the users.</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Changes to Terms</h2>
        <p>We reserve the right to modify these terms at any time. Changes will be effective immediately upon posting. Continued use of WebUtil after changes constitutes acceptance of new terms.</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-on-surface mb-2">Contact</h2>
        <p>For questions about these terms, please <a href="/contact" class="text-primary hover:underline">contact us</a>.</p>
      </section>
    </div>
  </div>
</BaseLayout>
