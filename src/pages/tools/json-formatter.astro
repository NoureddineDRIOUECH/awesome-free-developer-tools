---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";

const siteUrl = String(Astro.site).replace(/\/$/, "");
const pageUrl = `${siteUrl}/tools/json-formatter`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JSON Formatter Online",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  description:
    "Free online JSON formatter, validator and beautifier. Format, validate, and minify JSON instantly in your browser with no server upload.",
  url: pageUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: `${siteUrl}/tools`,
  author: { "@type": "Organization", name: "WebUtil" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}/tools` },
    { "@type": "ListItem", position: 3, name: "JSON Formatter Online", item: pageUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is a JSON formatter?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A JSON formatter is a tool that takes raw, minified, or poorly formatted JSON data and reformats it with proper indentation, line breaks, and spacing to make it human-readable.",
      },
    },
    {
      "@type": "Question",
      name: "Is this JSON formatter free?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, this JSON formatter is completely free to use with no limits, no sign-up required, and no data sent to any server — everything runs in your browser.",
      },
    },
    {
      "@type": "Question",
      name: "How do I validate my JSON?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Paste your JSON into the input field and click the Validate button. The tool will check if the JSON is valid and show any syntax errors with line numbers.",
      },
    },
  ],
};
---

<BaseLayout
  title="JSON Formatter Online - Free JSON Beautifier & Validator"
  description="Format, validate, and minify JSON instantly online. Free JSON beautifier that runs in your browser with no login required. Validate JSON syntax and identify errors."
  canonical={pageUrl}
  ogType="website"
  jsonLd={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="container-main py-12 sm:py-16">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm text-primary mb-6">
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
          Free Developer Tool — 100% Client-Side
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1]">
          JSON Formatter Online
        </h1>
        <p class="mt-4 text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          Format, validate, and minify JSON data instantly. Your data stays in your browser —
          nothing is uploaded, nothing is stored.
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-40 -right-40 size-96 rounded-full bg-primary/5 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 size-96 rounded-full bg-primary/5 blur-3xl"></div>
    </div>
  </section>

  <!-- Tool UI -->
  <section class="container-main pb-8">
    <div class="max-w-4xl mx-auto">
      <div class="tool-card p-4 sm:p-6">
        <div class="grid gap-4">
          <div>
            <label for="json-input" class="text-sm font-medium mb-1.5 block">
              JSON Input
              <span id="input-stats" class="text-on-surface-variant/60 font-normal text-xs ml-2"></span>
            </label>
            <textarea
              id="json-input"
              class="input-field font-mono text-sm min-h-[220px] resize-y scrollbar-thin"
              placeholder='{"name": "WebUtil", "type": "tool", "features": ["formatter", "validator", "minifier"]}'
              spellcheck="false"
            ></textarea>
          </div>

          <div class="flex flex-wrap gap-2">
            <button id="btn-format" class="btn-primary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
              </svg>
              Format
            </button>
            <button id="btn-minify" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/>
              </svg>
              Minify
            </button>
            <button id="btn-validate" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Validate
            </button>
            <button id="btn-clear" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Clear
            </button>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="json-output" class="text-sm font-medium">Output</label>
              <button id="btn-copy" class="text-xs text-primary hover:text-primary-hover transition-colors flex items-center gap-1">
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                Copy
              </button>
            </div>
            <div class="relative">
              <pre
                id="json-output"
                class="input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin"
              ></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <!-- SEO Content -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto prose-custom">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">What Is a JSON Formatter?</h2>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        A <strong>JSON formatter</strong> is a tool that takes raw, minified, or poorly formatted JSON data
        and reformats it with proper indentation, line breaks, and spacing to make it human-readable.
        This process is also called <strong>JSON beautification</strong> or <strong>JSON pretty-printing</strong>.
        Our free <strong>JSON formatter online</strong> runs entirely in your browser, meaning your data
        never leaves your device.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Why Validate JSON?</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        JSON validation is crucial when working with APIs, configuration files, or data exchange.
        A single missing comma or extra bracket can break an entire application. Using a
        <strong>JSON validator</strong> helps you catch syntax errors before they cause problems
        in production. Our validator highlights exact error positions so you can fix issues instantly.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Common JSON Errors</h3>
      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Trailing Commas</h4>
          <p class="mt-1 text-xs text-on-surface-variant">JSON does not allow trailing commas after the last item in an array or object.</p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Missing Quotes</h4>
          <p class="mt-1 text-xs text-on-surface-variant">All property names in JSON must be enclosed in double quotes.</p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Extra/Missing Commas</h4>
          <p class="mt-1 text-xs text-on-surface-variant">Missing commas between properties or extra commas at the end of arrays.</p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Mismatched Brackets</h4>
          <p class="mt-1 text-xs text-on-surface-variant">Unbalanced curly braces or square brackets cause parse failures.</p>
        </div>
      </div>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Use Cases for JSON Formatting</h3>
      <ul class="text-sm text-on-surface-variant leading-relaxed space-y-2 mb-6 list-disc pl-5">
        <li><strong>API Development</strong> — Format API response JSON for easier debugging and inspection.</li>
        <li><strong>Configuration Files</strong> — Read and edit JSON config files with clear structure.</li>
        <li><strong>Data Analysis</strong> — Pretty-print large JSON datasets for visual inspection.</li>
        <li><strong>Code Review</strong> — Share well-formatted JSON in pull requests and documentation.</li>
        <li><strong>Learning & Teaching</strong> — Understand JSON structure through proper indentation.</li>
      </ul>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">How to Format JSON</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        To format JSON, simply paste or type your raw JSON into the input field above and click
        <strong>Format</strong>. The tool will parse your JSON and display it with proper 2-space indentation.
        If your JSON is invalid, the error message will show you exactly where the problem is.
        You can then copy the formatted result with the <strong>Copy</strong> button.
      </p>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <!-- Related Tools -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-6">Related Tools</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="/tools/base64-encoder" class="tool-card block">
          <h3 class="font-semibold text-sm">Base64 Encoder</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Encode and decode Base64 data instantly.</p>
        </a>
        <a href="/tools/yaml-converter" class="tool-card block">
          <h3 class="font-semibold text-sm">YAML Converter</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Convert between JSON and YAML formats.</p>
        </a>
        <a href="/tools/xml-formatter" class="tool-card block">
          <h3 class="font-semibold text-sm">XML Formatter</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Format and validate XML documents.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">Related Guides</h2>
      <div class="grid gap-3">
        <a href="/blog/json-formatting-guide" class="tool-card block p-4">
          <p class="text-xs text-on-surface-variant mb-1">Blog Post</p>
          <h3 class="font-semibold text-sm">JSON Formatting Guide</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Read our comprehensive guide to learn more.</p>
        </a>
        <a href="/blog/common-json-errors" class="tool-card block p-4">
          <p class="text-xs text-on-surface-variant mb-1">Blog Post</p>
          <h3 class="font-semibold text-sm">Common JSON Errors</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Read our comprehensive guide to learn more.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById("json-input");
  const output = document.getElementById("json-output");
  const stats = document.getElementById("input-stats");
  const btnFormat = document.getElementById("btn-format");
  const btnMinify = document.getElementById("btn-minify");
  const btnValidate = document.getElementById("btn-validate");
  const btnClear = document.getElementById("btn-clear");
  const btnCopy = document.getElementById("btn-copy");

  function updateStats() {
    const chars = input.value.length;
    const lines = input.value ? input.value.split("\n").length : 0;
    stats.textContent = `${chars} chars · ${lines} lines`;
  }

  function processJSON(mode) {
    const raw = input.value.trim();
    if (!raw) {
      output.textContent = "Enter JSON data to process.";
      output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin";
      return;
    }
    try {
      const parsed = JSON.parse(raw);
      let result = "";
      if (mode === "format") {
        result = JSON.stringify(parsed, null, 2);
      } else if (mode === "minify") {
        result = JSON.stringify(parsed);
      } else if (mode === "validate") {
        result = "Valid JSON ✓";
      }
      output.textContent = result;
      output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin";
    } catch (e) {
      const msg = e.message;
      const posMatch = msg.match(/position\s+(\d+)/i);
      let display = "Invalid JSON\n\n" + msg;
      if (posMatch) {
        const pos = parseInt(posMatch[1]);
        const start = Math.max(0, pos - 30);
        const end = Math.min(raw.length, pos + 30);
        const snippet = raw.slice(start, end);
        const pointer = " ".repeat(Math.min(30, pos - start)) + "^";
        display += "\n\n" + snippet + "\n" + pointer;
      }
      output.textContent = display;
      output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin border-red-500/50";
    }
  }

  btnFormat.onclick = () => processJSON("format");
  btnMinify.onclick = () => processJSON("minify");
  btnValidate.onclick = () => processJSON("validate");

  btnClear.onclick = () => {
    input.value = "";
    output.textContent = "";
    output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin";
    updateStats();
    input.focus();
  };

  btnCopy.onclick = async () => {
    const text = output.textContent;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      btnCopy.innerHTML =
        '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        btnCopy.innerHTML =
          '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
      btnCopy.innerHTML =
        '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        btnCopy.innerHTML =
          '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    }
  };

  input.addEventListener("input", updateStats);

  updateStats();
</script>
