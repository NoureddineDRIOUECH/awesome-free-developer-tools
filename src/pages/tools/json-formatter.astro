---
import ToolLayout from "../../layouts/ToolLayout.astro";
import Toast from "../../components/Toast.astro";
import AdSlot from "../../components/AdSlot.astro";
import { getToolById } from "../../lib/tools";

const tool = getToolById("json-formatter")!;
const minifiedExample = `{"name":"WebUtil","type":"tool","features":["formatter","validator","minifier"],"version":1.0}`;
const formattedExample = `{\n  "name": "WebUtil",\n  "type": "tool",\n  "features": [\n    "formatter",\n    "validator",\n    "minifier"\n  ],\n  "version": 1.0\n}`;
---

<ToolLayout
  tool={tool}
  codeSnippets={[
    {
      lang: "javascript",
      label: "JavaScript",
      code: `// Format JSON with 2-space indentation\nconst formatted = JSON.stringify(parsedData, null, 2);\nconsole.log(formatted);\n\n// Minify JSON (remove whitespace)\nconst minified = JSON.stringify(parsedData);\nconsole.log(minified);\n\n// Validate JSON\nfunction validateJSON(str) {\n  try {\n    JSON.parse(str);\n    return { valid: true };\n  } catch (e) {\n    return { valid: false, error: e.message };\n  }\n}`,
    },
    {
      lang: "python",
      label: "Python",
      code: `import json\n\n# Format JSON with 2-space indentation\nformatted = json.dumps(data, indent=2)\nprint(formatted)\n\n# Minify JSON\nminified = json.dumps(data)\nprint(minified)\n\n# Validate JSON\ndef validate_json(s):\n    try:\n        json.loads(s)\n        return True\n    except json.JSONDecodeError as e:\n        return False`,
    },
    {
      lang: "go",
      label: "Go",
      code: `package main\n\nimport (\n    "encoding/json"\n    "fmt"\n    "bytes"\n)\n\n// Format JSON\nvar buf bytes.Buffer\nerr := json.Indent(&buf, data, "", "  ")\nif err != nil {\n    panic(err)\n}\nfmt.Println(buf.String())\n\n// Validate JSON\nfunc isValidJSON(s string) bool {\n    var js json.RawMessage\n    return json.Unmarshal([]byte(s), &js) == nil\n}`,
    },
    {
      lang: "bash",
      label: "Bash",
      code: `# Format JSON using jq\necho '{"name":"WebUtil","version":1}' | jq .\n\n# Format JSON file\njq . input.json > formatted.json\n\n# Minify JSON with jq -c\necho '{"name": "WebUtil"}' | jq -c .\n\n# Validate JSON\njq empty input.json && echo "Valid JSON" || echo "Invalid JSON"`,
    },
  ]}
  faqItems={[
    { question: "What is a JSON formatter?", answer: "A JSON formatter takes raw, minified, or poorly formatted JSON data and reformats it with proper indentation, line breaks, and spacing to make it human-readable. This is also called JSON beautification or JSON pretty-printing." },
    { question: "Is this JSON formatter free?", answer: "Yes, it is completely free with no limits, no sign-up required, and no data sent to any server. Everything runs in your browser using client-side JavaScript." },
    { question: "How do I validate JSON?", answer: "Paste your JSON into the input field and click Validate. The tool checks if the JSON is valid and shows syntax errors with line numbers so you can fix them quickly." },
    { question: "What is the difference between format and minify?", answer: "Formatting adds indentation and line breaks for readability. Minifying removes all optional whitespace to produce the smallest possible JSON string, useful for reducing file size in production." },
    { question: "Is my JSON data safe?", answer: "Yes. All processing happens entirely in your browser. Your JSON data never leaves your device — no uploads, no server requests, no logs." },
    { question: "Can I use this tool offline?", answer: "Once the page is loaded, the JSON formatter works fully offline. Since all processing is client-side, no internet connection is needed to format, validate, or minify JSON data." },
    { question: "Does the tool support JSON5?", answer: "This tool uses the standard JSON.parse method, which only accepts strict JSON. JSON5 (which allows comments, trailing commas, and single quotes) is not supported. For JSON5 formatting, consider using a specialized JSON5 tool." },
  ]}
>
  <section class="container-main pb-8">
    <div class="max-w-4xl mx-auto">
      <div class="tool-card p-4 sm:p-6">
        <div class="grid gap-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="json-input" class="text-sm font-medium">
                JSON Input
                <span id="input-stats" class="text-on-surface-variant/60 font-normal text-xs ml-2"></span>
              </label>
              <button id="btn-load-example" class="text-xs text-primary hover:text-primary-hover transition-colors flex items-center gap-1">
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Load Example
              </button>
            </div>
            <textarea
              id="json-input"
              class="input-field font-mono text-sm min-h-[220px] resize-y scrollbar-thin"
              placeholder='{"name": "WebUtil", "type": "tool", "features": ["formatter", "validator", "minifier"]}'
              spellcheck="false"
            ></textarea>
          </div>

          <div class="flex flex-wrap gap-2">
            <button id="btn-format" class="btn-primary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
              </svg>
              Format
            </button>
            <button id="btn-minify" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/>
              </svg>
              Minify
            </button>
            <button id="btn-validate" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Validate
            </button>
            <button id="btn-clear" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Clear
            </button>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="json-output" class="text-sm font-medium">Output</label>
              <button id="btn-copy" class="text-xs text-primary hover:text-primary-hover transition-colors flex items-center gap-1">
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                Copy
              </button>
            </div>
            <pre
              id="json-output"
              class="input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin"
            ></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto prose-custom">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">What Is a JSON Formatter?</h2>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        A <strong>JSON formatter</strong> is a tool that takes raw, minified, or poorly formatted JSON data
        and reformats it with proper indentation, line breaks, and spacing to make it human-readable.
        This process is also called <strong>JSON beautification</strong> or <strong>JSON pretty-printing</strong>.
        Our free <strong>JSON formatter online</strong> runs entirely in your browser, meaning your data
        never leaves your device.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Why Validate JSON?</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        JSON validation is crucial when working with APIs, configuration files, or data exchange.
        A single missing comma or extra bracket can break an entire application. Using a
        <strong>JSON validator</strong> helps you catch syntax errors before they cause problems
        in production. Our validator highlights exact error positions so you can fix issues instantly.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Common JSON Errors</h3>
      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Trailing Commas</h4>
          <p class="mt-1 text-xs text-on-surface-variant">JSON does not allow trailing commas after the last item in an array or object.</p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Missing Quotes</h4>
          <p class="mt-1 text-xs text-on-surface-variant">All property names in JSON must be enclosed in double quotes.</p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Extra/Missing Commas</h4>
          <p class="mt-1 text-xs text-on-surface-variant">Missing commas between properties or extra commas at the end of arrays.</p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm">Mismatched Brackets</h4>
          <p class="mt-1 text-xs text-on-surface-variant">Unbalanced curly braces or square brackets cause parse failures.</p>
        </div>
      </div>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Use Cases for JSON Formatting</h3>
      <ul class="text-sm text-on-surface-variant leading-relaxed space-y-2 mb-6 list-disc pl-5">
        <li><strong>API Development</strong> — Format API response JSON for easier debugging and inspection.</li>
        <li><strong>Configuration Files</strong> — Read and edit JSON config files with clear structure.</li>
        <li><strong>Data Analysis</strong> — Pretty-print large JSON datasets for visual inspection.</li>
        <li><strong>Code Review</strong> — Share well-formatted JSON in pull requests and documentation.</li>
        <li><strong>Learning & Teaching</strong> — Understand JSON structure through proper indentation.</li>
      </ul>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">How to Format JSON</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        To format JSON, simply paste or type your raw JSON into the input field above and click
        <strong>Format</strong>. The tool will parse your JSON and display it with proper 2-space indentation.
        If your JSON is invalid, the error message will show you exactly where the problem is.
        You can then copy the formatted result with the <strong>Copy</strong> button.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-10">JSON Formatting Examples</h3>
      <div class="space-y-4 mb-6">
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm mb-2">Before (Minified)</h4>
          <pre class="text-xs font-mono text-on-surface-variant bg-surface-container p-3 rounded-lg overflow-x-auto">{minifiedExample}</pre>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm mb-2">After (Formatted)</h4>
          <pre class="text-xs font-mono text-on-surface-variant bg-surface-container p-3 rounded-lg overflow-x-auto">{formattedExample}</pre>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<Toast />

<script>
  const input = document.getElementById("json-input");
  const output = document.getElementById("json-output");
  const stats = document.getElementById("input-stats");
  const btnFormat = document.getElementById("btn-format");
  const btnMinify = document.getElementById("btn-minify");
  const btnValidate = document.getElementById("btn-validate");
  const btnClear = document.getElementById("btn-clear");
  const btnCopy = document.getElementById("btn-copy");
  const btnLoad = document.getElementById("btn-load-example");

  function updateStats() {
    const chars = input.value.length;
    const lines = input.value ? input.value.split("\n").length : 0;
    stats.textContent = `${chars} chars · ${lines} lines`;
  }

  function processJSON(mode) {
    const raw = input.value.trim();
    if (!raw) {
      output.textContent = "Enter JSON data to process.";
      output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin";
      return;
    }
    try {
      const parsed = JSON.parse(raw);
      let result = "";
      if (mode === "format") result = JSON.stringify(parsed, null, 2);
      else if (mode === "minify") result = JSON.stringify(parsed);
      else if (mode === "validate") result = "Valid JSON ✓";
      output.textContent = result;
      output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin";
    } catch (e) {
      const msg = e.message;
      const posMatch = msg.match(/position\s+(\d+)/i);
      let display = "Invalid JSON\n\n" + msg;
      if (posMatch) {
        const pos = parseInt(posMatch[1]);
        const start = Math.max(0, pos - 30);
        const end = Math.min(raw.length, pos + 30);
        display += "\n\n" + raw.slice(start, end) + "\n" + " ".repeat(Math.min(30, pos - start)) + "^";
      }
      output.textContent = display;
      output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin border-red-500/50";
    }
  }

  btnFormat.onclick = () => processJSON("format");
  btnMinify.onclick = () => processJSON("minify");
  btnValidate.onclick = () => processJSON("validate");

  btnClear.onclick = () => {
    input.value = "";
    output.textContent = "";
    output.className = "input-field font-mono text-sm min-h-[180px] whitespace-pre-wrap overflow-auto scrollbar-thin";
    updateStats();
    input.focus();
  };

  btnLoad.onclick = () => {
    gtag('event', 'load_example', { tool_id: 'json-formatter' });
    input.value = '{"name":"WebUtil","type":"tool","features":["formatter","validator","minifier"],"version":1.0,"nested":{"enabled":true,"count":42,"tags":["dev","tools","json"]}}';
    updateStats();
    btnFormat.click();
  };

  btnCopy.onclick = async () => {
    const text = output.textContent;
    if (!text) return;
    try {
      gtag('event', 'copy', { tool_id: 'json-formatter', content_type: 'json-formatter' });
      await navigator.clipboard.writeText(text);
      if (window.showToast) showToast("Copied!");
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
      if (window.showToast) showToast("Copied!");
    }
  };

  input.addEventListener("input", updateStats);
  updateStats();
</script>
