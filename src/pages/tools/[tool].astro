---
import { tools } from "../../lib/tools";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { tool: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;

const categoryMap: Record<string, string> = {
  formatters: "dev", encoders: "dev", converters: "dev",
  text: "text", generators: "generate",
  images: "dev", security: "dev", web: "dev",
};

const prefix = categoryMap[tool.category] || "dev";
const target = `/${prefix}/${tool.id}`;
const siteUrl = String(Astro.site).replace(/\/$/, "");
const canonical = `${siteUrl}${target}`;
---
<html>
  <head>
    <meta charset="utf-8">
    <title>{tool.title} - WebUtil</title>
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script>window.location.replace(`/${prefix}/${tool.id}`);</script>
  </head>
  <body>
    <p>Moved to <a href={target}>{canonical}</a></p>
  </body>
</html>
