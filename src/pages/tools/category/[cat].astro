---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { categories, getToolsByCategory, getCategoryInfo, tools, type ToolCategory } from "../../../lib/tools";

export function getStaticPaths() {
  const catsWithTools = categories.filter((c) => getToolsByCategory(c.id).length > 0);
  return catsWithTools.map((cat) => ({
    params: { cat: cat.id },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const category = getCategoryInfo(cat.id)!;
const categoryTools = getToolsByCategory(cat.id);
const siteUrl = String(Astro.site).replace(/\/$/, "");
const pageUrl = `${siteUrl}/tools/category/${cat.id}`;

const categoryRouteMap: Record<string, string> = {
  formatters: "dev", encoders: "dev", converters: "dev",
  text: "text", generators: "generate",
  images: "dev", security: "dev", web: "dev",
};

const blogLinks: Record<string, { title: string; slug: string }[]> = {
  formatters: [
    { title: "JSON Formatting Guide", slug: "json-formatting-guide" },
    { title: "Common JSON Errors", slug: "common-json-errors" },
    { title: "JSON vs XML", slug: "json-vs-xml" },
    { title: "JSON Schema Guide", slug: "json-schema-guide" },
    { title: "How APIs Use JSON", slug: "how-apis-use-json" },
    { title: "SQL Formatting Guide", slug: "sql-formatting-guide" },
    { title: "XML Formatting Guide", slug: "xml-formatting-guide" },
  ],
  encoders: [
    { title: "URL Encoding Guide", slug: "url-encoding-decoding" },
    { title: "Base64 Encoding Guide", slug: "base64-encoding-methods" },
    { title: "HTML Entities Guide", slug: "html-entities-guide" },
  ],
  security: [
    { title: "Password Security Best Practices", slug: "password-security-best-practices" },
    { title: "Online Tool Security", slug: "online-tools-security" },
    { title: "Hash Generator Guide", slug: "hash-generator-guide" },
  ],
  converters: [
    { title: "Color Converter Guide", slug: "color-converter-guide" },
    { title: "YAML Converter Guide", slug: "yaml-converter-guide" },
  ],
  generators: [
    { title: "UUID Guide", slug: "uuid-guide" },
    { title: "Lorem Ipsum Guide", slug: "lorem-ipsum-guide" },
  ],
  text: [
    { title: "Case Converter Guide", slug: "case-converter-guide" },
    { title: "Markdown Preview Guide", slug: "markdown-guide" },
    { title: "Text Diff Guide", slug: "text-diff-guide" },
  ],
  images: [
    { title: "Image Converter Guide", slug: "image-converter-guide" },
  ],
};

const categoryGuides = blogLinks[cat.id] || [];

const categoryDescriptions: Record<string, string> = {
  formatters: "Formatters help developers maintain consistent code style across projects. JSON formatters validate and beautify API responses, configuration files, and data exports with proper indentation and syntax error detection. SQL formatters make complex queries readable by capitalizing keywords and aligning clauses. XML formatters handle document structures with namespace support. Proper formatting reduces debugging time, improves code review quality, and enforces team conventions without manual effort. All formatting tools on WebUtil run entirely client-side — your code never leaves your browser.",
  encoders: "Encoders and decoders convert data between different representations for safe transmission and storage. Base64 encoding embeds binary data in text formats like JSON and HTML. URL encoding ensures special characters in query parameters and URL paths are transmitted correctly. HTML entity encoding prevents XSS attacks and renders special characters safely in web pages. These conversions are fundamental to web development — every API call, form submission, and page render depends on proper encoding. WebUtil's encoder tools process everything in your browser with zero server uploads.",
  generators: "Generators create random or structured data for development, testing, and security. UUID generators produce unique identifiers for database keys and distributed system references — choose between random v4 and time-ordered v7 formats. Password generators create cryptographically strong passwords using the Web Crypto API with customizable character sets. QR code generators encode URLs, Wi-Fi credentials, and text into scannable images. Lorem Ipsum generators provide realistic placeholder text for designs and mockups. All generation uses your browser's native APIs — no data is sent to external servers.",
  converters: "Converters transform data between formats and units for compatibility across tools and platforms. Color converters translate between HEX, RGB, HSL, and named CSS colors with live preview — essential for web design and accessibility compliance. YAML converters bridge configuration files and JSON APIs, supporting comments and nested structures. Image converters resize and reformat PNG, JPEG, WebP, and GIF files using the browser's Canvas API. CSS unit converters translate px to rem for accessible, scalable designs. Every conversion happens locally — your files and data stay private.",
  text: "Text tools manipulate and analyze string content for writing, development, and data cleaning. Case converters transform naming conventions between camelCase, PascalCase, snake_case, kebab-case, and more for cross-language compatibility. Markdown previewers render GitHub-flavored Markdown with live HTML output for documentation and README files. Diff checkers compare text side-by-side highlighting additions, deletions, and changes for code review. Regex testers validate patterns with real-time match highlighting and group capture. Word counters track words, characters, sentences, and reading time for content optimization. All processing is client-side with no data uploads.",
  images: "Image tools process visual assets directly in your browser using the Canvas API. Convert between PNG (lossless with transparency), JPEG (lossy compression for photos), WebP (modern format with 25-35% smaller files), and GIF (simple animations). Unlike server-based image converters, WebUtil processes everything locally — your images never leave your device. This is critical for sensitive visual data like design mockups, product photos, and personal images. The Canvas API handles all decoding and encoding natively in your browser with quality settings for output format optimization.",
  security: "Security tools help developers implement authentication, encryption, and data integrity without exposing sensitive information. JWT decoders inspect token headers, payloads, and signatures for debugging authentication flows. Hash generators compute MD5, SHA-1, SHA-256, and SHA-512 digests for file integrity verification and password hashing. Password generators create strong, unique credentials resistant to brute force and dictionary attacks. JWT expiration checkers validate token lifetimes and claims for secure session management. Every security tool runs 100% client-side — your secrets, tokens, and passwords never reach any server.",
  web: "Web tools help developers build, test, and validate modern infrastructure and deployment configurations. Kubernetes YAML validators check pod, deployment, and service manifests for correct structure and required fields before cluster apply. Docker Compose validators verify docker-compose.yml syntax, service definitions, port mappings, and volume configurations. GitHub Actions validators validate workflow YAML files including triggers, jobs, steps, and action references. These validators catch syntax errors and configuration issues before they reach production, saving deployment time and preventing outages. All validation runs in your browser with no file uploads.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}/tools` },
    { "@type": "ListItem", position: 3, name: category.name, item: pageUrl },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${category.name} - Free Online Developer Tools`,
  description: `Browse free online ${cat.id} tools. ${category.description}. All tools run 100% in your browser with no server uploads.`,
  url: pageUrl,
};
---

<BaseLayout
  title={`${category.name} Tools - Free Online Developer Tools`}
  description={`Free online ${cat.id} tools: ${categoryTools.map(t => t.title).join(", ")}. ${category.description}. 100% client-side, no data upload.`}
  canonical={pageUrl}
  jsonLd={[breadcrumbSchema, collectionSchema]}
>
  <div class="container-main py-10">
    <div class="max-w-4xl mx-auto">
      <nav class="text-xs text-on-surface-variant mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/tools" class="hover:text-primary transition-colors">Tools</a>
        <span>/</span>
        <span class="text-on-surface">{category.name}</span>
      </nav>

      <div class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{category.name} Tools</h1>
        <p class="mt-3 text-base text-on-surface-variant max-w-2xl leading-relaxed">
          {category.description}. All tools run entirely in your browser —
          nothing is uploaded, nothing is stored.
        </p>
      </div>

      <div class="prose prose-sm max-w-none text-on-surface-variant leading-relaxed mb-8">
        <p>{categoryDescriptions[cat.id]}</p>
      </div>

      <div class="grid gap-4">
        {categoryTools.map((tool) => {
          const prefix = categoryRouteMap[tool.category] || "dev";
          return (
          <a
            href={`/${prefix}/${tool.id}`}
            class="tool-card block p-5 hover:border-primary/30 transition-colors"
          >
            <h2 class="text-lg font-semibold group-hover:text-primary transition-colors">{tool.title}</h2>
            <p class="mt-1.5 text-sm text-on-surface-variant leading-relaxed">{tool.description}</p>
          </a>
          );
        })}
      </div>

      {categoryGuides.length > 0 && (
        <>
          <h2 class="text-2xl font-semibold tracking-tight mt-12 mb-4">Related Guides</h2>
          <div class="grid gap-3">
            {categoryGuides.map((guide) => (
              <a
                href={`/blog/${guide.slug}`}
                class="tool-card block p-4"
              >
                <p class="text-xs text-on-surface-variant mb-1">Blog Post</p>
                <h3 class="font-semibold text-sm">{guide.title}</h3>
              </a>
            ))}
          </div>
        </>
      )}

      <AdSlot format="in-article" class="mt-8" />
    </div>
  </div>
</BaseLayout>
