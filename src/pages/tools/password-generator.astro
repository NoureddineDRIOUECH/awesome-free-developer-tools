---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";

const siteUrl = String(Astro.site).replace(/\/$/, "");
const pageUrl = `${siteUrl}/tools/password-generator`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Secure Password Generator Online",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  description:
    "Free online secure password generator. Create strong random passwords with customizable length, symbols, numbers, and uppercase letters. 100% client-side.",
  url: pageUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: `${siteUrl}/tools`,
  author: { "@type": "Organization", name: "WebUtil" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}/tools` },
    { "@type": "ListItem", position: 3, name: "Secure Password Generator Online", item: pageUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How long should my password be?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A strong password should be at least 12 characters long. For maximum security, we recommend 16-20 characters that include a mix of uppercase letters, lowercase letters, numbers, and symbols.",
      },
    },
    {
      "@type": "Question",
      name: "What makes a password strong?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A strong password is long, random, and uses a mix of character types (uppercase, lowercase, numbers, symbols). It should not contain dictionary words, personal information, or predictable patterns.",
      },
    },
    {
      "@type": "Question",
      name: "Is this password generator secure?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. The entire process runs in your browser using the Web Crypto API for cryptographically secure random number generation. No passwords are ever sent to any server or stored anywhere.",
      },
    },
  ],
};
---

<BaseLayout
  title="Secure Password Generator Online"
  description="Free online secure password generator. Create strong random passwords with customizable length, symbols, numbers, and uppercase letters. 100% client-side."
  canonical={pageUrl}
  ogType="website"
  jsonLd={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="container-main py-12 sm:py-16">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm text-primary mb-6">
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          Free Developer Tool — 100% Client-Side
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1]">
          Secure Password Generator Online
        </h1>
        <p class="mt-4 text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          Create strong, random passwords instantly in your browser. Customize length,
          character types, and generate cryptographically secure passwords — no server uploads.
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-40 -right-40 size-96 rounded-full bg-primary/5 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 size-96 rounded-full bg-primary/5 blur-3xl"></div>
    </div>
  </section>

  <!-- Tool UI -->
  <section class="container-main pb-8">
    <div class="max-w-4xl mx-auto">
      <div class="tool-card p-4 sm:p-6">
        <div class="grid gap-6">
          <!-- Length -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="pw-length" class="text-sm font-medium">Password Length</label>
              <span id="pw-length-val" class="text-sm font-medium text-primary tabular-nums">20</span>
            </div>
            <input
              type="range"
              id="pw-length"
              min="4"
              max="128"
              value="20"
              class="w-full accent-primary"
            />
            <div class="flex justify-between text-xs text-on-surface-variant/60 mt-1">
              <span>4</span>
              <span>128</span>
            </div>
          </div>

          <!-- Options -->
          <fieldset>
            <legend class="text-sm font-medium mb-2">Character Options</legend>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="pw-upper" checked class="size-4 accent-primary" />
                <span class="text-sm">A–Z</span>
              </label>
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="pw-lower" checked class="size-4 accent-primary" />
                <span class="text-sm">a–z</span>
              </label>
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="pw-nums" checked class="size-4 accent-primary" />
                <span class="text-sm">0–9</span>
              </label>
              <label class="flex items-center gap-2 p-3 rounded-lg border border-primary/10 bg-primary/[0.02] hover:bg-primary/5 transition-colors cursor-pointer has-checked:border-primary/40 has-checked:bg-primary/10">
                <input type="checkbox" id="pw-syms" checked class="size-4 accent-primary" />
                <span class="text-sm">!@#$%</span>
              </label>
            </div>
          </fieldset>

          <!-- Generate -->
          <div class="flex items-center gap-2">
            <button id="pw-generate" class="btn-primary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Generate Password
            </button>
            <button id="pw-copy" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copy
            </button>
          </div>

          <!-- Output -->
          <div>
            <label class="text-sm font-medium mb-1.5 block">Generated Password</label>
            <pre
              id="pw-output"
              class="input-field font-mono text-sm min-h-[56px] whitespace-pre-wrap overflow-auto scrollbar-thin break-all select-all"
            ></pre>
          </div>

          <!-- Strength Meter -->
          <div id="pw-strength" class="hidden">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-medium">Password Strength</span>
              <p id="pw-strength-label" class="text-sm font-medium"></p>
            </div>
            <div class="h-2 rounded-full bg-primary/10 overflow-hidden">
              <div id="pw-strength-bar" class="h-full rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <!-- SEO Content -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">What Makes a Password Secure?</h2>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        A <strong>secure password</strong> is the first line of defense against unauthorized access to
        your online accounts. The most <strong>strong passwords</strong> are long, random, and contain a
        mix of character types. Using a <strong>free password generator</strong> ensures you create
        truly random passwords that are resistant to brute-force attacks, dictionary attacks, and common
        guessing techniques. Our <strong>online password generator</strong> creates cryptographically
        secure passwords using the Web Crypto API, making each <strong>random password</strong>
        unique and unpredictable.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Password Strength Guidelines</h3>
      <ul class="text-sm text-on-surface-variant leading-relaxed space-y-2 mb-6 list-disc pl-5">
        <li><strong>Use at least 12 characters</strong> — Longer passwords are exponentially harder to crack. Aim for 16-20 characters when possible.</li>
        <li><strong>Mix character types</strong> — Combine uppercase letters, lowercase letters, numbers, and symbols to maximize entropy.</li>
        <li><strong>Avoid dictionary words</strong> — Do not use real words, common phrases, or keyboard patterns like <code>qwerty</code> or <code>123456</code>.</li>
        <li><strong>Never use personal information</strong> — Avoid names, birthdates, addresses, or any information that could be found on social media.</li>
        <li><strong>Use a unique password for every account</strong> — Never reuse passwords across different websites or services.</li>
      </ul>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">How to Use This Password Generator</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        Using our <strong>secure password generator</strong> is simple. First, adjust the
        <strong>password length</strong> using the slider — longer passwords provide stronger security.
        Next, select the character types you want included: uppercase letters (A–Z), lowercase letters
        (a–z), numbers (0–9), and symbols (!@#$%). For maximum security, enable all four options.
        Click <strong>Generate Password</strong> to create a new <strong>strong random password</strong>.
        Review the strength meter to see how secure your password is, then use the
        <strong>Copy</strong> button to save it to your clipboard.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Tips for Managing Generated Passwords</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        Once you generate a <strong>strong password</strong>, use a <strong>password manager</strong>
        like 1Password, Bitwarden, or Apple Keychain to store it securely. Password managers encrypt
        your vault and can auto-fill credentials on websites, making it easy to use unique,
        complex passwords everywhere. Enable <strong>two-factor authentication (2FA)</strong> on all
        accounts that support it for an additional security layer. Never write passwords on sticky notes,
        save them in plain text files, or share them through email or messaging apps.
      </p>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <!-- Related Tools -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-6">Related Tools</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="/tools/uuid-generator" class="tool-card block">
          <h3 class="font-semibold text-sm">UUID Generator</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Generate random UUIDs and GUIDs instantly.</p>
        </a>
        <a href="/tools/base64-encoder" class="tool-card block">
          <h3 class="font-semibold text-sm">Base64 Encoder</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Encode and decode Base64 strings in your browser.</p>
        </a>
        <a href="/tools/lorem-ipsum" class="tool-card block">
          <h3 class="font-semibold text-sm">Lorem Ipsum Generator</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Generate placeholder text for your designs.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guide -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">Related Guide</h2>
      <a href="/blog/password-security-best-practices" class="tool-card block p-4">
        <p class="text-xs text-on-surface-variant mb-1">Blog Post</p>
        <h3 class="font-semibold text-sm">Password Security Guide</h3>
        <p class="mt-1 text-xs text-on-surface-variant">Read our comprehensive guide to learn more.</p>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const lengthInput = document.getElementById("pw-length");
  const lengthVal = document.getElementById("pw-length-val");
  const upperChk = document.getElementById("pw-upper");
  const lowerChk = document.getElementById("pw-lower");
  const numsChk = document.getElementById("pw-nums");
  const symsChk = document.getElementById("pw-syms");
  const genBtn = document.getElementById("pw-generate");
  const output = document.getElementById("pw-output");
  const strengthDiv = document.getElementById("pw-strength");
  const strengthBar = document.getElementById("pw-strength-bar");
  const strengthLabel = document.getElementById("pw-strength-label");
  const copyBtn = document.getElementById("pw-copy");

  const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const LOWER = "abcdefghijklmnopqrstuvwxyz";
  const NUMS = "0123456789";
  const SYMS = "!@#$%^&*()_+-=[]{}|;:,.<>?";

  const STRENGTH_COLORS = ["#ef4444", "#f59e0b", "#eab308", "#22c55e", "#22c55e"];
  const STRENGTH_LABELS = ["Very Weak", "Weak", "Fair", "Strong", "Very Strong"];

  lengthInput.addEventListener("input", () => {
    lengthVal.textContent = lengthInput.value;
  });

  function getCharset() {
    let chars = "";
    if (upperChk.checked) chars += UPPER;
    if (lowerChk.checked) chars += LOWER;
    if (numsChk.checked) chars += NUMS;
    if (symsChk.checked) chars += SYMS;
    return chars;
  }

  function generatePassword(length, charset) {
    if (!charset) return "";
    const array = new Uint32Array(length);
    crypto.getRandomValues(array);
    let password = "";
    for (let i = 0; i < length; i++) {
      password += charset[array[i] % charset.length];
    }
    return password;
  }

  function calculateStrength(password) {
    let score = 0;
    if (password.length >= 8) score++;
    if (password.length >= 12) score++;
    if (password.length >= 16) score++;
    if (/[a-z]/.test(password) && /[A-Z]/.test(password)) score++;
    if (/\d/.test(password) && /[^a-zA-Z0-9]/.test(password)) score++;
    return Math.min(score, 5);
  }

  function updateStrength(password) {
    const score = calculateStrength(password);
    const idx = Math.max(0, score - 1);
    strengthBar.style.width = ((score / 5) * 100) + "%";
    strengthBar.style.backgroundColor = STRENGTH_COLORS[idx];
    strengthLabel.textContent = STRENGTH_LABELS[idx];
    strengthLabel.style.color = STRENGTH_COLORS[idx];
    strengthDiv.classList.remove("hidden");
  }

  genBtn.onclick = () => {
    const length = parseInt(lengthInput.value, 10);
    const charset = getCharset();
    if (!charset) {
      output.textContent = "Select at least one character type.";
      return;
    }
    const password = generatePassword(length, charset);
    output.textContent = password;
    updateStrength(password);
  };

  copyBtn.onclick = async () => {
    const text = output.textContent;
    if (!text || text === "Select at least one character type.") return;
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.innerHTML =
        '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        copyBtn.innerHTML =
          '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
      copyBtn.innerHTML =
        '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        copyBtn.innerHTML =
          '<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    }
  };
</script>
