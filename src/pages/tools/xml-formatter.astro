---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import PopularTools from "../../components/PopularTools.astro";

const siteUrl = String(Astro.site).replace(/\/$/, "");
const pageUrl = `${siteUrl}/tools/xml-formatter`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "XML Formatter Online - Beautify XML Data",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  description:
    "Free online XML formatter and validator. Beautify, minify, and validate XML data with syntax highlighting. 100% client-side processing.",
  url: pageUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: `${siteUrl}/tools`,
  author: { "@type": "Organization", name: "WebUtil" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}/tools` },
    { "@type": "ListItem", position: 3, name: "XML Formatter Online - Beautify XML Data", item: pageUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Why should I format my XML?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Formatting XML with proper indentation makes it easier to read, debug, and maintain. Well-formatted XML helps developers quickly understand the document structure and identify nesting errors.",
      },
    },
    {
      "@type": "Question",
      name: "How does XML formatting work?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The tool parses your XML using the browser's built-in DOMParser, then serializes it back with proper indentation. Each nested element gets additional indentation, making the hierarchical structure visually clear.",
      },
    },
    {
      "@type": "Question",
      name: "Is my XML data sent to a server?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. The XML formatting happens entirely in your browser using native DOMParser and XMLSerializer APIs. Your data never leaves your computer.",
      },
    },
  ],
};
---

<BaseLayout
  title="XML Formatter Online - Beautify XML Data"
  description="Free online XML formatter and validator. Beautify, minify, and validate XML data with syntax highlighting. 100% client-side processing."
  canonical={pageUrl}
  ogType="website"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Tools", href: "/tools" },
    { label: "Formatters", href: "/tools/category/formatters" },
    { label: "XML Formatter" },
  ]},
  jsonLd={[softwareSchema, breadcrumbSchema, faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="container-main py-12 sm:py-16">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm text-primary mb-6">
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
          Free Developer Tool — 100% Client-Side
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1]">
          XML Formatter Online
        </h1>
        <p class="mt-4 text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          Beautify, validate, and format your XML data instantly. Your data stays in your browser —
          nothing is uploaded, nothing is stored.
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-40 -right-40 size-96 rounded-full bg-primary/5 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 size-96 rounded-full bg-primary/5 blur-3xl"></div>
    </div>
  </section>

  <!-- Tool UI -->
  <section class="container-main pb-8">
    <div class="max-w-4xl mx-auto">
      <div class="tool-card p-4 sm:p-6">
        <div class="grid gap-4">
          <div>
            <label for="xml-input" class="text-sm font-medium mb-1.5 block">
              XML Input
              <span id="input-stats" class="text-on-surface-variant/60 font-normal text-xs ml-2"></span>
            </label>
            <textarea
              id="xml-input"
              class="input-field font-mono text-sm min-h-[200px] resize-y scrollbar-thin"
              placeholder="<root><item>value</item></root>"
              spellcheck="false"
            ></textarea>
          </div>

          <div class="flex items-center gap-2">
            <button id="xml-format" class="btn-primary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
              Format XML
            </button>
            <button id="xml-clear" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Clear
            </button>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="xml-output" class="text-sm font-medium">Formatted Output</label>
              <button id="btn-copy" class="text-xs text-primary hover:text-primary-hover transition-colors flex items-center gap-1">
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                Copy
              </button>
            </div>
            <pre
              id="xml-output"
              class="input-field font-mono text-sm min-h-[200px] whitespace-pre-wrap overflow-auto scrollbar-thin break-all"
            ></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <!-- SEO Content -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">What Is XML Formatting?</h2>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        <strong>XML formatting</strong> (also called XML beautification or XML pretty-print) is the
        process of restructuring raw XML data with proper indentation, line breaks, and spacing to
        make the document structure human-readable. A <strong>formatted XML document</strong> uses
        consistent indentation to show each element's nesting level, making it dramatically easier to
        spot errors, understand relationships, and edit the data. Our free <strong>XML formatter
        online</strong> runs entirely in your browser for instant, private formatting.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">XML vs JSON vs YAML</h3>
      <div class="grid sm:grid-cols-3 gap-3 mb-6">
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">XML</h4>
          <p class="mt-1 text-xs text-on-surface-variant">
            Best for documents with mixed content (text + elements), complex schemas (XSD), and
            enterprise systems like SOAP web services and configuration files. Supports attributes,
            namespaces, and comments out of the box.
          </p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">JSON</h4>
          <p class="mt-1 text-xs text-on-surface-variant">
            Best for REST APIs, web applications, and lightweight data exchange. JSON has a simpler
            syntax and is natively supported in JavaScript, making it faster to parse in browser
            environments.
          </p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">YAML</h4>
          <p class="mt-1 text-xs text-on-surface-variant">
            Best for configuration files (Docker Compose, CI/CD pipelines, Ansible) where human
            readability is the top priority. YAML uses indentation-based structure and supports
            comments and multi-line strings.
          </p>
        </div>
      </div>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Common XML Use Cases</h3>
      <ul class="text-sm text-on-surface-variant leading-relaxed space-y-2 mb-6 list-disc pl-5">
        <li><strong>Configuration Files</strong> — Application configs in XML (e.g., Maven POM, Ant build files, web.xml).</li>
        <li><strong>Web Services (SOAP)</strong> — SOAP APIs exchange structured XML messages between systems.</li>
        <li><strong>Data Exchange</strong> — XML is widely used in B2B integrations, RSS/Atom feeds, and OpenStreetMap data.</li>
        <li><strong>Document Storage</strong> — Office documents (DOCX, XLSX) and SVG graphics are XML-based under the hood.</li>
      </ul>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">How to Use This XML Formatter</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        To <strong>format XML</strong> data, paste your raw XML string into the input textarea and
        click <strong>Format XML</strong>. The tool will parse the document and output a
        beautifully indented version. Each nesting level adds two spaces of indentation so the
        element hierarchy is clearly visible. If the XML contains syntax errors, an error message
        explains what went wrong. Use the <strong>Copy</strong> button to copy the formatted result
        to your clipboard.
      </p>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  
  <section class="container-main py-8">
    <div class="max-w-4xl mx-auto">
      <PopularTools />
    </div>
  </section>

  <!-- Related Tools -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-6">Related Tools</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="/tools/json-formatter" class="tool-card block">
          <h3 class="font-semibold text-sm">JSON Formatter</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Format, validate, and beautify JSON data.</p>
        </a>
        <a href="/tools/yaml-converter" class="tool-card block">
          <h3 class="font-semibold text-sm">YAML Converter</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Convert between YAML, JSON, and XML.</p>
        </a>
        <a href="/tools/sql-formatter" class="tool-card block">
          <h3 class="font-semibold text-sm">SQL Formatter</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Beautify and format SQL queries.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById("xml-input");
  const output = document.getElementById("xml-output");
  const stats = document.getElementById("input-stats");
  const btnFormat = document.getElementById("xml-format");
  const btnClear = document.getElementById("xml-clear");
  const btnCopy = document.getElementById("btn-copy");

  function updateStats() {
    const chars = input.value.length;
    const lines = input.value ? input.value.split("\n").length : 0;
    stats.textContent = `${chars} chars · ${lines} lines`;
  }

  function formatXml(xml) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(xml, "text/xml");

    const parseError = doc.querySelector("parsererror");
    if (parseError) {
      throw new Error(parseError.textContent.trim());
    }

    const serializer = new XMLSerializer();
    const serialized = serializer.serializeToString(doc);

    let depth = 0;
    const result = serialized.replace(/(<\/?[^>]+>)/g, (match) => {
      if (match.startsWith("</")) {
        depth--;
      }

      const indent = "  ".repeat(Math.max(0, depth));
      let formatted = "\n" + indent + match;

      if (match.endsWith("/>")) {
        // self-closing — don't change depth
      } else if (!match.startsWith("</")) {
        depth++;
      }

      return formatted;
    });

    return result.trimStart();
  }

  btnFormat.onclick = () => {
    const raw = input.value.trim();
    if (!raw) {
      output.textContent = "Enter XML to format.";
      output.className = "input-field font-mono text-sm min-h-[200px] whitespace-pre-wrap overflow-auto scrollbar-thin break-all";
      return;
    }
    try {
      const result = formatXml(raw);
      output.textContent = result;
      output.className = "input-field font-mono text-sm min-h-[200px] whitespace-pre-wrap overflow-auto scrollbar-thin break-all";
    } catch (e) {
      output.textContent = "XML parsing error: " + e.message;
      output.className = "input-field font-mono text-sm min-h-[200px] whitespace-pre-wrap overflow-auto scrollbar-thin break-all border-red-500/50";
    }
  };

  btnClear.onclick = () => {
    input.value = "";
    output.textContent = "";
    output.className = "input-field font-mono text-sm min-h-[200px] whitespace-pre-wrap overflow-auto scrollbar-thin break-all";
    updateStats();
    input.focus();
  };

  btnCopy.onclick = async () => {
    const text = output.textContent;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      btnCopy.innerHTML =
        '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        btnCopy.innerHTML =
          '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
      btnCopy.innerHTML =
        '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => {
        btnCopy.innerHTML =
          '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
      }, 2000);
    }
  };

  input.addEventListener("input", updateStats);

  updateStats();
</script>
