---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import AdSlot from "../../components/AdSlot.astro";
import { tools, categories, type ToolCategory } from "../../lib/tools";

const selectedCategory = Astro.url.searchParams.get("category") as ToolCategory | null;
const searchQuery = Astro.url.searchParams.get("q") || "";

let filteredTools = tools;

if (selectedCategory) {
  filteredTools = filteredTools.filter((t) => t.category === selectedCategory);
}

if (searchQuery) {
  const q = searchQuery.toLowerCase();
  filteredTools = filteredTools.filter(
    (t) =>
      t.title.toLowerCase().includes(q) ||
      t.description.toLowerCase().includes(q) ||
      t.keywords.some((k) => k.toLowerCase().includes(q))
  );
}

const allSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "All Free Online Developer Tools",
  description: `Browse all ${tools.length} free online developer tools. Format JSON, encode Base64, generate passwords, and more.`,
  url: `${String(Astro.site).replace(/\/$/, "")}/tools`,
};
---

<BaseLayout
  title={`All Developer Tools${selectedCategory ? ` - ${categories.find(c => c.id === selectedCategory)?.name}` : ""}`}
  description={`Browse all ${filteredTools.length} free online developer tools. ${selectedCategory ? `${categories.find(c => c.id === selectedCategory)?.name}: ` : ""}Format, encode, generate, and convert data entirely in your browser.`}
  jsonLd={allSchema}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Tools" },
  ]}
>
  <div class="container-main py-10">
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
        {selectedCategory
          ? categories.find((c) => c.id === selectedCategory)?.name || "All Tools"
          : "All Developer Tools"}
      </h1>
      <p class="mt-2 text-on-surface-variant">
        {selectedCategory
          ? categories.find((c) => c.id === selectedCategory)?.description
          : `${tools.length} free tools across ${categories.length} categories`}
      </p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="mb-6 space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
        <div class="relative w-full sm:max-w-xs">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-on-surface-variant/50 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="tool-search"
            type="search"
            placeholder="Search tools by name, description, or keywords..."
            value={searchQuery}
            class="input-field w-full pl-9"
          />
        </div>
        <p class="text-sm text-on-surface-variant whitespace-nowrap shrink-0">
          <span id="visible-count">{filteredTools.length}</span> of {tools.length} tools
        </p>
      </div>

      <div id="category-filters" class="flex flex-wrap gap-2">
        <button
          type="button"
          data-category=""
          class="chip"
          class:list={{ active: !selectedCategory }}
        >
          All ({tools.length})
        </button>
        {categories.map((cat) => {
          const count = tools.filter((t) => t.category === cat.id).length;
          return (
            <button
              type="button"
              data-category={cat.id}
              class="chip"
              class:list={{ active: selectedCategory === cat.id }}
            >
              {cat.name} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <AdSlot format="banner" className="mb-8" />

    <!-- Tools Grid -->
    <div id="tools-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <div class="tool-card-wrapper" data-category={tool.category}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>

    <div id="no-results" class="text-center py-16 hidden">
      <p class="text-on-surface-variant">No tools found matching your criteria.</p>
    </div>

    <!-- Category descriptions (SEO) -->
    {!selectedCategory && (
      <section class="mt-16 pt-8 border-t border-surface-container-highest">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 text-sm text-on-surface-variant leading-relaxed">
          {categories.map((cat) => (
            <div>
              <h3 class="font-semibold text-on-surface mb-2">{cat.name}</h3>
              <p>{cat.description}</p>
              <a href={`/tools?category=${cat.id}`} class="text-primary hover:underline mt-2 inline-block">
                Browse {cat.name} &rarr;
              </a>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script is:inline>
(function () {
  const tools = JSON.parse(document.getElementById("tools-data").textContent);
  const searchInput = document.getElementById("tool-search");
  const categoryChips = document.querySelectorAll("#category-filters .chip");
  const wrappers = document.querySelectorAll(".tool-card-wrapper");
  const noResults = document.getElementById("no-results");
  const countEl = document.getElementById("visible-count");

  let activeCategory = new URLSearchParams(location.search).get("category") || "";
  let searchQuery = new URLSearchParams(location.search).get("q") || "";

  function updateActiveChip() {
    categoryChips.forEach((chip) => {
      chip.classList.toggle("active", chip.dataset.category === activeCategory);
    });
  }

  function filter() {
    const q = searchQuery.toLowerCase().trim();
    let visible = 0;

    tools.forEach((tool, i) => {
      const wrapper = wrappers[i];
      const matchesSearch =
        !q ||
        tool.title.toLowerCase().includes(q) ||
        tool.description.toLowerCase().includes(q) ||
        tool.keywords.some((k) => k.toLowerCase().includes(q));
      const matchesCategory = !activeCategory || tool.category === activeCategory;
      wrapper.style.display = matchesSearch && matchesCategory ? "" : "none";
      if (matchesSearch && matchesCategory) visible++;
    });

    countEl.textContent = visible;
    noResults.classList.toggle("hidden", visible > 0);
  }

  searchInput.addEventListener("input", function () {
    searchQuery = this.value;
    filter();
  });

  categoryChips.forEach((chip) => {
    chip.addEventListener("click", function () {
      activeCategory = this.dataset.category;
      updateActiveChip();
      filter();
    });
  });

  updateActiveChip();
  if (searchQuery) {
    searchInput.value = searchQuery;
    filter();
  }
})();
</script>

<script type="application/json" id="tools-data">{JSON.stringify(tools.map(t => ({
  title: t.title,
  description: t.description,
  category: t.category,
  keywords: t.keywords
})))
}</script>
