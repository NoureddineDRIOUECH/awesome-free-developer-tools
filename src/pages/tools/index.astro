---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import AdSlot from "../../components/AdSlot.astro";
import { tools, categories, type ToolCategory } from "../../lib/tools";

const selectedCategory = Astro.url.searchParams.get("category") as ToolCategory | null;
const searchQuery = Astro.url.searchParams.get("q") || "";

let filteredTools = tools;

if (selectedCategory) {
  filteredTools = filteredTools.filter((t) => t.category === selectedCategory);
}

if (searchQuery) {
  const q = searchQuery.toLowerCase();
  filteredTools = filteredTools.filter(
    (t) =>
      t.title.toLowerCase().includes(q) ||
      t.description.toLowerCase().includes(q) ||
      t.keywords.some((k) => k.toLowerCase().includes(q))
  );
}

const toolsJson = JSON.stringify(tools.map(t => ({
  title: t.title,
  description: t.description,
  category: t.category,
  keywords: t.keywords
})));
const allSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "All Free Online Developer Tools",
  description: `Browse all ${tools.length} free online developer tools. Format JSON, encode Base64, generate passwords, and more.`,
  url: `${String(Astro.site).replace(/\/$/, "")}/tools`,
};
---

<BaseLayout
  title={`All Developer Tools${selectedCategory ? ` - ${categories.find(c => c.id === selectedCategory)?.name}` : ""}`}
  description={`Browse all ${filteredTools.length} free online developer tools. ${selectedCategory ? `${categories.find(c => c.id === selectedCategory)?.name}: ` : ""}Format, encode, generate, and convert data entirely in your browser.`}
  jsonLd={allSchema}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Tools" },
  ]}
>
  <div class="container-main py-10">
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
        {selectedCategory
          ? categories.find((c) => c.id === selectedCategory)?.name || "All Tools"
          : "All Developer Tools"}
      </h1>
      <p class="mt-2 text-on-surface-variant">
        {selectedCategory
          ? categories.find((c) => c.id === selectedCategory)?.description
          : `${tools.length} free tools across ${categories.length} categories`}
      </p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="mb-6 space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
        <div class="relative w-full sm:max-w-xs">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-on-surface-variant/50 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="tool-search"
            type="search"
            placeholder="Search tools by name, description, or keywords..."
            value={searchQuery}
            class="input-field w-full pl-9"
          />
        </div>
        <p class="text-sm text-on-surface-variant whitespace-nowrap shrink-0">
          <span id="visible-count">{filteredTools.length}</span> of {tools.length} tools
        </p>
      </div>

      <div id="category-filters" class="flex flex-wrap gap-2">
        <button
          type="button"
          data-category=""
          class="chip"
          class:list={{ active: !selectedCategory }}
        >
          All ({tools.length})
        </button>
        {categories.map((cat) => {
          const count = tools.filter((t) => t.category === cat.id).length;
          return (
            <button
              type="button"
              data-category={cat.id}
              class="chip"
              class:list={{ active: selectedCategory === cat.id }}
            >
              {cat.name} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <AdSlot format="banner" className="mb-8" />

    {selectedCategory && (
      <section class="mb-8 text-sm text-on-surface-variant leading-relaxed max-w-3xl">
        <p>{
          selectedCategory === "formatters" ? "Formatters help developers maintain consistent code style across projects. JSON formatters validate and beautify API responses, configuration files, and data exports with proper indentation and syntax error detection. SQL formatters make complex queries readable by capitalizing keywords and aligning clauses. XML formatters handle document structures with namespace support. All formatting tools on WebUtil run entirely client-side." :
          selectedCategory === "encoders" ? "Encoders and decoders convert data between different representations for safe transmission and storage. Base64 encoding embeds binary data in text formats like JSON and HTML. URL encoding ensures special characters in query parameters are transmitted correctly. HTML entity encoding prevents XSS attacks and renders special characters safely in web pages. WebUtil's encoder tools process everything in your browser with zero server uploads." :
          selectedCategory === "generators" ? "Generators create random or structured data for development, testing, and security. UUID generators produce unique identifiers for database keys and distributed system references. Password generators create cryptographically strong passwords using the Web Crypto API. QR code generators encode URLs and Wi-Fi credentials into scannable images. All generation uses your browser's native APIs with no server uploads." :
          selectedCategory === "converters" ? "Converters transform data between formats and units for compatibility across tools and platforms. Color converters translate between HEX, RGB, HSL, and named CSS colors with live preview. YAML converters bridge configuration files and JSON APIs. Image converters reformat PNG, JPEG, WebP, and GIF files using the Canvas API. Every conversion happens locally in your browser." :
          selectedCategory === "text" ? "Text tools manipulate and analyze string content for writing and development. Case converters transform naming conventions between camelCase, snake_case, kebab-case, and more. Markdown previewers render GitHub-flavored Markdown with live HTML output. Diff checkers compare text side-by-side for code review. Regex testers validate patterns with real-time highlighting. All processing is client-side with no data uploads." :
          selectedCategory === "images" ? "Image tools process visual assets directly in your browser using the Canvas API. Convert between PNG, JPEG, WebP, and GIF formats with quality settings. Unlike server-based converters, WebUtil processes everything locally — your images never leave your device. This is critical for sensitive design mockups, product photos, and personal images." :
          selectedCategory === "security" ? "Security tools help developers implement authentication and encryption without exposing sensitive information. JWT decoders inspect token headers and payloads for debugging authentication flows. Hash generators compute MD5, SHA-1, SHA-256, and SHA-512 digests. Password generators create strong credentials resistant to attacks. Every security tool runs 100% client-side." :
          selectedCategory === "web" ? "Web tools help developers validate modern infrastructure and deployment configurations. Kubernetes YAML validators check pod and service manifests before cluster apply. Docker Compose validators verify docker-compose.yml syntax and service definitions. GitHub Actions validators validate workflow triggers, jobs, and action references. All validation runs in your browser with no file uploads." :
          ""
        }</p>
      </section>
    )}

    <!-- Tools Grid -->
    <div id="tools-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <div class="tool-card-wrapper" data-category={tool.category}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>

    <div id="no-results" class="text-center py-16 hidden">
      <p class="text-on-surface-variant">No tools found matching your criteria.</p>
    </div>

    <!-- Category descriptions (SEO) -->
    {!selectedCategory && (
      <section class="mt-16 pt-8 border-t border-surface-container-highest">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 text-sm text-on-surface-variant leading-relaxed">
          {categories.map((cat) => (
            <div>
              <h3 class="font-semibold text-on-surface mb-2">{cat.name}</h3>
              <p>{cat.description}</p>
              <a href={`/tools?category=${cat.id}`} class="text-primary hover:underline mt-2 inline-block">
                Browse {cat.name} &rarr;
              </a>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

</BaseLayout>

<script type="application/json" id="tools-data" set:html={toolsJson}></script>

<script>
document.addEventListener("astro:page-load", function () {
  var dataEl = document.getElementById("tools-data");
  if (!dataEl) return;
  var tools = JSON.parse(dataEl.textContent);
  var searchInput = document.getElementById("tool-search");
  var categoryChips = document.querySelectorAll("#category-filters .chip");
  var wrappers = document.querySelectorAll(".tool-card-wrapper");
  var noResults = document.getElementById("no-results");
  var countEl = document.getElementById("visible-count");
  if (!searchInput || !countEl) return;

  var activeCategory = new URLSearchParams(location.search).get("category") || "";
  var searchQuery = new URLSearchParams(location.search).get("q") || "";

  function updateActiveChip() {
    categoryChips.forEach(function (chip) {
      chip.classList.toggle("active", chip.dataset.category === activeCategory);
    });
  }

  function filter() {
    var q = searchQuery.toLowerCase().trim();
    var visible = 0;

    tools.forEach(function (tool, i) {
      var wrapper = wrappers[i];
      if (!wrapper) return;
      var matchesSearch =
        !q ||
        tool.title.toLowerCase().includes(q) ||
        tool.description.toLowerCase().includes(q) ||
        tool.keywords.some(function (k) { return k.toLowerCase().includes(q); });
      var matchesCategory = !activeCategory || tool.category === activeCategory;
      wrapper.style.display = matchesSearch && matchesCategory ? "" : "none";
      if (matchesSearch && matchesCategory) visible++;
    });

    countEl.textContent = visible;
    noResults.classList.toggle("hidden", visible > 0);
  }

  searchInput.addEventListener("input", function () {
    searchQuery = this.value;
    filter();
  });

  categoryChips.forEach(function (chip) {
    chip.addEventListener("click", function () {
      activeCategory = this.dataset.category;
      updateActiveChip();
      filter();
    });
  });

  updateActiveChip();
  if (searchQuery) {
    searchInput.value = searchQuery;
    filter();
  }
});
</script>
