---
import ToolLayout from "../../layouts/ToolLayout.astro";
import Toast from "../../components/Toast.astro";
import AdSlot from "../../components/AdSlot.astro";
import { getToolById } from "../../lib/tools";

const tool = getToolById("jwt-expiration-checker")!;
---

<ToolLayout
  tool={tool}
>
  <!-- Tool UI -->
  <section class="container-main pb-8">
    <div class="max-w-4xl mx-auto">
      <div class="tool-card p-4 sm:p-6">
        <div class="grid gap-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="jwt-input" class="text-sm font-medium">JWT Token</label>
              <button id="btn-load-example" class="text-xs text-primary hover:text-primary-hover transition-colors flex items-center gap-1">
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Load Example
              </button>
            </div>
            <textarea
              id="jwt-input"
              class="input-field font-mono text-sm min-h-[120px] resize-y scrollbar-thin"
              placeholder="Paste your JWT token here to check expiration..."
              spellcheck="false"
            ></textarea>
          </div>

          <div class="flex flex-wrap gap-2">
            <button id="btn-check" class="btn-primary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Check Expiration
            </button>
            <button id="btn-clear" class="btn-secondary text-sm">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Clear
            </button>
          </div>

          <!-- Results -->
          <div id="jwt-output" class="space-y-4 hidden">
            <!-- Expiry Status Badge -->
            <div id="expiry-badge" class="hidden"></div>

            <!-- Decoded Sections -->
            <div class="tool-card p-4">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-semibold">Header</h3>
                <button id="copy-header" class="text-xs text-primary hover:text-primary-hover transition-colors flex items-center gap-1">
                  <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  Copy
                </button>
              </div>
              <pre id="jwt-header" class="input-field font-mono text-sm min-h-[60px] whitespace-pre-wrap overflow-auto scrollbar-thin"></pre>
            </div>

            <div class="tool-card p-4">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-semibold">Payload</h3>
                <button id="copy-payload" class="text-xs text-primary hover:text-primary-hover transition-colors flex items-center gap-1">
                  <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  Copy
                </button>
              </div>
              <pre id="jwt-payload" class="input-field font-mono text-sm min-h-[100px] whitespace-pre-wrap overflow-auto scrollbar-thin"></pre>
            </div>

            <!-- Time Info Cards -->
            <div id="time-info" class="grid sm:grid-cols-2 gap-3 hidden"></div>
          </div>

          <div id="jwt-error" class="hidden">
            <div class="rounded-lg border border-red-500/50 bg-red-500/5 p-4">
              <p id="jwt-error-msg" class="text-sm text-red-400"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />

  <!-- SEO Content -->
  <section class="container-main py-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-semibold tracking-tight mb-4">What Is a JWT Expiration Checker?</h2>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        A <strong>JWT expiration checker</strong> decodes JSON Web Tokens and inspects their time-based
        claims — specifically <code class="text-primary">exp</code> (expiration) and
        <code class="text-primary">iat</code> (issued at). JWTs are commonly used for authentication
        and authorization, and tokens include an expiration time to limit their validity period. Our
        <strong>JWT token expiry checker</strong> shows you exactly when a token expires, how much
        time remains, and whether the token is still valid.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Why Token Expiration Matters</h3>
      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">Security</h4>
          <p class="mt-1 text-xs text-on-surface-variant">Expired tokens cannot be reused, limiting the damage if a token is leaked. Short expiration times (15–60 minutes) are standard practice.</p>
        </div>
        <div class="tool-card p-4">
          <h4 class="font-medium text-sm text-primary">Refresh Tokens</h4>
          <p class="mt-1 text-xs text-on-surface-variant">Access tokens expire quickly; refresh tokens have longer lifespans. The <code class="text-primary">exp</code> claim controls when re-authentication is required.</p>
        </div>
      </div>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">How to Use This JWT Expiration Checker</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
        Paste your JWT token into the input field and click <strong>Check Expiration</strong>. The
        tool decodes the header and payload, displays the expiration and issued-at timestamps as
        human-readable dates, and shows a color-coded status badge — <span class="text-green-400">green</span>
        for valid tokens with time remaining, <span class="text-red-400">red</span> for expired tokens.
        Use <strong>Load Example</strong> to see a sample token with an active expiration. All
        processing is client-side; your tokens are never transmitted.
      </p>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Understanding JWT Time Claims</h3>
      <ul class="text-sm text-on-surface-variant leading-relaxed space-y-2 mb-6 list-disc pl-5">
        <li><strong>exp (Expiration)</strong> — Unix timestamp (seconds since epoch) when the token expires. The token is invalid after this time.</li>
        <li><strong>iat (Issued At)</strong> — Unix timestamp when the token was created. Used to calculate token age.</li>
        <li><strong>nbf (Not Before)</strong> — Unix timestamp before which the token is not yet valid.</li>
        <li><strong>auth_time</strong> — Unix timestamp of when the user authenticated (commonly used in OpenID Connect).</li>
      </ul>

      <h3 class="text-xl font-semibold tracking-tight mb-3 mt-8">Is Checking JWT Expiration Locally Safe?</h3>
      <p class="text-sm text-on-surface-variant leading-relaxed">
        Yes. This <strong>JWT expiry checker</strong> runs entirely in your browser. JWT tokens are
        Base64Url-encoded, not encrypted — anyone with the token can decode and read the header and
        payload. However, the <strong>signature cannot be verified</strong> without the secret key.
        Never share your secret key or put sensitive data in a JWT payload. Use this tool to inspect
        and debug your tokens safely.
      </p>
    </div>
  </section>

  <AdSlot format="banner" class="container-main my-4" />
</ToolLayout>

<Toast />

<script>
  const input = document.getElementById("jwt-input");
  const btnCheck = document.getElementById("btn-check");
  const btnClear = document.getElementById("btn-clear");
  const output = document.getElementById("jwt-output");
  const error = document.getElementById("jwt-error");
  const errorMsg = document.getElementById("jwt-error-msg");
  const headerEl = document.getElementById("jwt-header");
  const payloadEl = document.getElementById("jwt-payload");
  const copyHeader = document.getElementById("copy-header");
  const copyPayload = document.getElementById("copy-payload");
  const expiryBadge = document.getElementById("expiry-badge");
  const timeInfo = document.getElementById("time-info");
  const btnLoad = document.getElementById("btn-load-example");

  function base64UrlDecode(str) {
    str = str.replace(/-/g, "+").replace(/_/g, "/");
    const padding = str.length % 4;
    if (padding) str += "=".repeat(4 - padding);
    try {
      const decoded = atob(str);
      return decodeURIComponent(
        decoded
          .split("")
          .map((c) => "%" + c.charCodeAt(0).toString(16).padStart(2, "0"))
          .join("")
      );
    } catch {
      return "";
    }
  }

  function decodeJWTPayload(token) {
    const parts = token.trim().split(".");
    if (parts.length !== 3) {
      throw new Error("Invalid JWT: A JWT must have 3 parts separated by dots (header.payload.signature).");
    }
    const [headerEnc, payloadEnc] = parts;
    if (!headerEnc || !payloadEnc) {
      throw new Error("Invalid JWT: Token parts cannot be empty.");
    }
    const header = JSON.parse(base64UrlDecode(headerEnc));
    const payload = JSON.parse(base64UrlDecode(payloadEnc));
    return { header, payload };
  }

  function formatTime(ts) {
    const d = new Date(ts * 1000);
    return d.toLocaleString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      timeZoneName: "short",
    });
  }

  function formatDuration(seconds) {
    const abs = Math.abs(seconds);
    const days = Math.floor(abs / 86400);
    const hours = Math.floor((abs % 86400) / 3600);
    const mins = Math.floor((abs % 3600) / 60);
    const secs = Math.floor(abs % 60);
    const parts = [];
    if (days > 0) parts.push(`${days}d`);
    if (hours > 0) parts.push(`${hours}h`);
    if (mins > 0) parts.push(`${mins}m`);
    if (secs > 0 || parts.length === 0) parts.push(`${secs}s`);
    return parts.join(" ");
  }

  function copyText(text, btnEl) {
    if (!text) return;
    const orig = btnEl.innerHTML;
    gtag('event', 'copy', { tool_id: 'jwt-expiration-checker', content_type: 'jwt-expiration-checker' });
    navigator.clipboard.writeText(text).then(() => {
      if (window.showToast) showToast("Copied!");
      btnEl.innerHTML =
        '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => { btnEl.innerHTML = orig; }, 2000);
    }).catch(() => {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
      if (window.showToast) showToast("Copied!");
      btnEl.innerHTML =
        '<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
      setTimeout(() => { btnEl.innerHTML = orig; }, 2000);
    });
  }

  btnCheck.onclick = () => {
    const raw = input.value.trim();
    if (!raw) {
      errorMsg.textContent = "Paste a JWT token to check.";
      error.classList.remove("hidden");
      output.classList.add("hidden");
      return;
    }

    error.classList.add("hidden");
    try {
      const { header, payload } = decodeJWTPayload(raw);
      headerEl.textContent = JSON.stringify(header, null, 2);
      payloadEl.textContent = JSON.stringify(payload, null, 2);

      copyHeader.onclick = () => copyText(headerEl.textContent, copyHeader);
      copyPayload.onclick = () => copyText(payloadEl.textContent, copyPayload);

      const now = Math.floor(Date.now() / 1000);
      const exp = payload.exp;
      const iat = payload.iat;
      const nbf = payload.nbf;

      let badgeHTML = "";

      if (exp) {
        const diff = exp - now;
        const expired = diff <= 0;
        if (expired) {
          badgeHTML +=
            `<div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-red-500/10 border border-red-500/30 text-sm">
              <svg class="size-4 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.503-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.771.833.192 2.5 1.732 2.5z"/>
              </svg>
              <span class="text-red-300 font-medium">EXPIRED</span>
              <span class="text-red-400/70">(expired ${formatDuration(Math.abs(diff))} ago · ${formatTime(exp)})</span>
            </div>`;
        } else {
          badgeHTML +=
            `<div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-green-500/10 border border-green-500/30 text-sm">
              <svg class="size-4 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-green-300 font-medium">VALID</span>
              <span class="text-green-400/70">(${formatDuration(diff)} remaining · expires ${formatTime(exp)})</span>
            </div>`;
        }
      }

      let timeInfoHTML = "";
      if (iat) {
        const age = now - iat;
        timeInfoHTML +=
          `<div class="tool-card p-3">
            <h4 class="text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider mb-1">Issued At (iat)</h4>
            <p class="text-sm font-medium">${formatTime(iat)}</p>
            <p class="text-xs text-on-surface-variant/60 mt-0.5">Token age: ${formatDuration(age)}</p>
          </div>`;
      }
      if (exp) {
        timeInfoHTML +=
          `<div class="tool-card p-3">
            <h4 class="text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider mb-1">Expiration (exp)</h4>
            <p class="text-sm font-medium">${formatTime(exp)}</p>
            <p class="text-xs text-on-surface-variant/60 mt-0.5">${exp - now > 0 ? `${formatDuration(exp - now)} remaining` : `Expired ${formatDuration(now - exp)} ago`}</p>
          </div>`;
      }
      if (nbf) {
        timeInfoHTML +=
          `<div class="tool-card p-3">
            <h4 class="text-xs font-medium text-on-surface-variant/60 uppercase tracking-wider mb-1">Not Before (nbf)</h4>
            <p class="text-sm font-medium">${formatTime(nbf)}</p>
            <p class="text-xs text-on-surface-variant/60 mt-0.5">${now >= nbf ? "Token is active" : "Token is not yet valid"}</p>
          </div>`;
      }

      if (badgeHTML) {
        expiryBadge.innerHTML = badgeHTML;
        expiryBadge.classList.remove("hidden");
      } else {
        expiryBadge.classList.add("hidden");
      }

      if (timeInfoHTML) {
        timeInfo.innerHTML = timeInfoHTML;
        timeInfo.classList.remove("hidden");
      } else {
        timeInfo.classList.add("hidden");
      }

      output.classList.remove("hidden");
      error.classList.add("hidden");
    } catch (e) {
      errorMsg.innerHTML =
        '<span class="font-medium">Decode failed:</span> ' +
        e.message.replace(/</g, "&lt;").replace(/>/g, "&gt;");
      error.classList.remove("hidden");
      output.classList.add("hidden");
    }
  };

  btnClear.onclick = () => {
    input.value = "";
    output.classList.add("hidden");
    error.classList.add("hidden");
    expiryBadge.classList.add("hidden");
    timeInfo.classList.add("hidden");
    headerEl.textContent = "";
    payloadEl.textContent = "";
    input.focus();
  };

  btnLoad.onclick = () => {
    gtag('event', 'load_example', { tool_id: 'jwt-expiration-checker' });
    input.value = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNzE4MDAwMDAwLCJleHAiOjk5OTk5OTk5OTl9.dGhpcyBpcyBhIGZha2Ugc2lnbmF0dXJl';
    btnCheck.click();
  };

  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      btnCheck.click();
    }
  });
</script>
