---
import ToolLayout from "../../layouts/ToolLayout.astro";
import { getRelatedTools, getCategoryInfo, tools } from "../../lib/tools";
import type { ToolDefinition } from "../../lib/tools";

export function getStaticPaths() {
  const dedicated = [
    "json-formatter", "base64-encoder", "url-encoder", "jwt-decoder",
    "hash-generator", "html-entities", "yaml-converter", "color-converter",
    "image-converter", "sql-formatter", "xml-formatter", "json-to-csv",
    "px-to-rem", "kubernetes-yaml-validator", "docker-compose-validator",
    "github-actions-validator", "jwt-expiration-checker",
  ];
  const cats = ["formatters", "encoders", "converters", "images", "security", "web"];
  return tools
    .filter((t) => cats.includes(t.category) && !dedicated.includes(t.id))
    .map((tool) => ({
      params: { tool: tool.id },
      props: { tool },
    }));
}

const { tool } = Astro.props as { tool: ToolDefinition };
const relatedTools = getRelatedTools(tool.id);
const category = getCategoryInfo(tool.category);

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.title,
  description: tool.metaDescription,
  url: `${String(Astro.site).replace(/\/$/, "")}/dev/${tool.id}`,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: "WebUtil" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: String(Astro.site).replace(/\/$/, "") },
    { "@type": "ListItem", position: 2, name: "Dev Tools", item: `${String(Astro.site).replace(/\/$/, "")}/dev` },
    { "@type": "ListItem", position: 3, name: tool.title, item: `${String(Astro.site).replace(/\/$/, "")}/dev/${tool.id}` },
  ],
};
---

<ToolLayout
  title={tool.title}
  description={tool.metaDescription}
  tool={tool}
  relatedTools={relatedTools}
  jsonLd={[toolSchema, breadcrumbSchema]}
>
  <div id="tool-root" class="p-4 sm:p-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-lg font-semibold">
        {tool.title.charAt(0)}
      </div>
      <div>
        <p class="text-sm text-on-surface-variant">{category?.name || "Dev Tool"}</p>
      </div>
    </div>
    <div id="tool-ui" class="space-y-4">
      <p class="text-sm text-on-surface-variant">Loading tool interface...</p>
    </div>
  </div>
</ToolLayout>

<script>
  const toolId = window.location.pathname.split("/").pop();
  if (toolId && window.setupTool) {
    window.setupTool(toolId);
  }
</script>
